   295
   296 22EF			.proc	reset_veronica
   297 22EF				.using	NVeronica.NProtocol, NVeronica.NProtocol.EAtariRegisterStates
   298 					
   299 					//	Pulse low
   300 					NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, VER_CPU_RESET_MASK|SEMAPHORE_MASK, #(VER_CPU_RESET_PULSE_LOW | LOCK_ATARI)
   301 					
   302 					//	Wait some time.
   303 					NVeronica.NProtocol.reset_wait
   304
   305 					//	Pulse high. Veronica's CPU should reset now.
   306 					NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, VER_CPU_RESET_MASK|SEMAPHORE_MASK, #(VER_CPU_RESET_PULSE_HIGH | UNLOCK_ATARI)
   307 					
   308 					//NVeronica.NProtocol.reset_wait
   309 					//	Allow Veronica's CPU to stabilize.
   310 					rts
   311 				.endp
   312
   313 				//******************************************************************************************************************************************************
   314
   315 22EF			.proc	swap_and_reset
   316 22EF				.using	NVeronica.NProtocol, NVeronica.NProtocol.EAtariRegisterStates
   317 					
   318 					//	Reset pulse low, switch rambanks
   319 					NVeronica.NProtocol.set_or_switch_bits	Atari_HW_Register, VER_CPU_RESET_MASK, VER_CPU_RESET_PULSE_LOW, RAMBANK_CFG_MASK
   320 					
   321 					//	Wait some time.
   322 					//NVeronica.NProtocol.reset_wait
   323
   324 					//	Pulse high. Veronica's CPU should reset now.
   325 					NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, SEMAPHORE_MASK|VER_CPU_RESET_MASK, #(UNLOCK_ATARI|VER_CPU_RESET_PULSE_HIGH)
   326 					
   327 					//NVeronica.NProtocol.reset_wait
   328 					rts
   329 				.endp
