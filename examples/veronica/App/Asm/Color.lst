   311 				///	Copy data chunk from source into destination location. Range restricted to one page only. Uses code auto-modification.
   312 				/**	@param .word dst_ptr	Destination location pointer. Should be page aligned to achieve best performance.
   313 					@param .word src_ptr	Source location pointer. Should be page aligned to achieve best performance.
   314 					@param .byte count		Count.
   315 				*/
   315
   316 218D			.proc	memcpyhp(.word dst_ptr .word src_ptr .byte count) .var
   317 					count	= NMemory.count
   318 					
   319 					ldy	count
   320 					bne	continue
   321 					rts
