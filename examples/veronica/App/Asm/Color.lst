    13 22CD D0 F1				bne	loop
    16 22CF A9 00				lda	#NUtils.FALSE
    17 22D1 4C D6 22				jmp	done
    19 22D4				matched:
    20 22D4 A9 01				lda	#NUtils.TRUE
    21 22D6				done:
Source: Master.as8
