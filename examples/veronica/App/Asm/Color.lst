Macro: NVeronica.NProtocol.wait_for_veronica_with_timeout [Source: Protocol.h8]
     1 22C0				loop:
     2 22C0 AD C0 D5				lda	Atari_HW_Register
     3 22C3 29 80				and	#(1 << (EAtariRegisterBits.SEMAPHORE_READ))
     5 22C5 D0 0D					bne	matched
     2 22C7 A0 00			ldy	#0
     3 22C9			loop
     4 22C9 C8				iny
     5 22CA D0 FD			bne	loop
