    15 				///	Compares two tables for equality.
    16 				/**	@param .word tbl0_ptr	First table pointer.
    17 					@param .word tbl1_ptr	Second table pointer.
    18 					@param .byte size		Table size. Must be greater than zero.
    19 					@return A	- Flag indicating comparison status.
    20 						NUtils.TRUE		Equal.
    21 						NUtils.FALSE	Different.
    22 				*/
    22
    23 20F0			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 					tbl0_ptr = NMemory.ptr
    25 					tbl1_ptr = NMemory.ptr2
    26 					count = NMemory.count
    27
    28 					ldy	#0
    29 					ldx	count+1
    30 					beq	last_page
    31
    32 20F0				.local	full_pages
    33 20F0				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 20F0				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 20F0				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 20F0			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 20F0			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Compares two half-page sized tables for equality. Uses code auto-modification.
    70 				/**	@param .word tbl0_ptr	First table pointer.
    71 					@param .word tbl1_ptr	Second table pointer.
    72 					@param .byte size		Table size.
    73 					@return A	- Flag indicating comparison status.
    74 						NUtils.TRUE		Equal.
    75 						NUtils.FALSE	Different.
    76 				*/
    76
    77 20F0			.proc	strcmphp(.word tbl0_ptr .word tbl1_ptr .byte size) .var
    78 = 20F1				size = * + 1
    79 20F0 A0 FF				ldy	#$ff
    80 20F2 88				dey
    81 20F3			loop
    82 = 20F4				tbl0_ptr = *+1
    83 20F3 B9 FF FF				lda	$ffff,y
    84 = 20F7				tbl1_ptr = *+1
    85 20F6 D9 FF FF				cmp	$ffff,y
    86 20F9 D0 06			bne	inequality
    87 					
    88 20FB 88				dey
    89 20FC 10 F5			bpl	loop
    90 					
    91 					//	equality
    92 20FE A9 01			lda	#NUtils.TRUE
    93 2100 60				rts
    94
    95 2101			inequality
    96 2101 A9 00			lda	#NUtils.FALSE
    97 2103 60				rts
    98 				.endp
