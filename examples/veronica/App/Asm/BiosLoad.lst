    14
    15 				///	Compares two tables for equality.
    16 				/**	@param .word tbl0_ptr	First table pointer.
    17 					@param .word tbl1_ptr	Second table pointer.
    18 					@param .byte size		Table size. Must be greater than zero.
    19 					@return A	- Flag indicating comparison status.
    20 						NUtils.TRUE		Equal.
    21 						NUtils.FALSE	Different.
    22 				*/
    22
    23 20AD			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 					tbl0_ptr = NMemory.ptr
    25 					tbl1_ptr = NMemory.ptr2
    26 					count = NMemory.count
    27
    28 					ldy	#0
    29 					ldx	count+1
    30 					beq	last_page
    31
    32 20AD				.local	full_pages
    33 20AD				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 20AD				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 20AD				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 20AD			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 20AD			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Compares two half-page sized tables for equality. Uses code auto-modification.
    70 				/**	@param .word tbl0_ptr	First table pointer.
    71 					@param .word tbl1_ptr	Second table pointer.
    72 					@param .byte size		Table size.
    73 					@return A	- Flag indicating comparison status.
    74 						NUtils.TRUE		Equal.
    75 						NUtils.FALSE	Different.
    76 				*/
    76
    77 20AD			.proc	strcmphp(.word tbl0_ptr .word tbl1_ptr .byte size) .var
    78 					size = * + 1
    79 						ldy	#$ff
    80 					dey
    81 20AD			loop
    82 					tbl0_ptr = *+1
    83 						lda	$ffff,y
    84 					tbl1_ptr = *+1
    85 						cmp	$ffff,y
    86 					bne	inequality
    87 					
    88 					dey
    89 					bpl	loop
    90 					
    91 					//	equality
    92 					lda	#NUtils.TRUE
    93 					rts
    94
    95 20AD			inequality
    96 					lda	#NUtils.FALSE
    97 					rts
    98 				.endp
