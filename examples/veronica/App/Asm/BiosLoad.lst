   368 				*/
   368
   369 2136			.proc	memcpym(.word dst_ptr .word dst_modulo .word src_ptr .byte width .byte height .word src_modulo) .var
   370 					dst_ptr = NMemory.ptr
   371 2136				.var	.word	dst_modulo
   372 					src_ptr = NMemory.ptr2
   373 2136				.var	.word	src_modulo
   374 					
   375 2136			loop_y
   376 					ldy	#0
   377 2136			loop_x
   378 					NUtils.movba	"(src_ptr),y", "(dst_ptr),y"
   379 					iny
   380 					cpy	width
   381 					bne	loop_x
   382 					
   383 					NUtils.addw	src_ptr, src_modulo, src_ptr
   384 					NUtils.addw	dst_ptr, dst_modulo, dst_ptr
   385
   386 					dec	height
   387 					bne	loop_y
   388 					rts
   389 				.endp
   390
   391 				//******************************************************************************************************************************************************
   392
   393 				///	Backup memory locations.
   394 				/**	@param .word tbl_ptr	Backup table pointer.
   395 				*/
   395
   396 2136			.proc	backup(.word tbl_ptr) .var
   397 					tbl_ptr = NMemory.ptr
   398 					tmp_ptr = NMemory.ptr2
   399 					
   400 2136			loop
   401 					ldy	#0
   402 					NUtils.cmpba	"(tbl_ptr),y", #EType.NONE
   403 					bne	cont
   404 						//	Exit.
   405 						rts
   406 2136			cont
   407 					ldy	#1
   408 					NUtils.movba	"(tbl_ptr),y", tmp_ptr
   409 					iny
   410 					NUtils.movba	"(tbl_ptr),y", tmp_ptr+1
   411
   412 					//	Copy the first byte.
   413 					ldy	#0
   414 					lda	(tmp_ptr),y
   415 					ldy	#3
   416 					sta	(tbl_ptr),y
   417 					
   418 					//	if	(tbl_ptr[0] == EType.BYTE)
   419 					ldy	#0
   420 					NUtils.cmpba	"(tbl_ptr),y", #EType.BYTE
   421 					bne	cont_2
   422 						NUtils.addbw	tbl_ptr, #4, tbl_ptr
   423 						jmp	loop
   424 					
   425 2136			cont_2
   426 					//	if	(tbl_ptr[0] == EType.WORD)
   427 					//ldy	#0
   428 					NUtils.cmpba	"(tbl_ptr),y", #EType.WORD
   429 					bne	cont_3
   430 						//	Copy second byte.
   431 						ldy	#1
   432 						lda	(tmp_ptr),y
   433 						ldy	#4
   434 						sta	(tbl_ptr),y
   435 						NUtils.addbw	tbl_ptr, #5, tbl_ptr
   436 						jmp	loop
   437 					
   438 2136			cont_3
   439 					jmp	loop
   440 				.endp
   441
   442 				//******************************************************************************************************************************************************
   443
   444 				///	Restore memory locations.
   445 				/**	@param .word tbl_ptr	Backup table pointer.
   446 				*/
   446
   447 2136			.proc	restore(.word tbl_ptr) .var
   448 					tbl_ptr = NMemory.ptr
   449 					tmp_ptr = NMemory.ptr2
   450 					
   451 2136			loop
   452 					ldy	#0
   453 					NUtils.cmpba	"(tbl_ptr),y", #EType.NONE
   454 					bne	cont
   455 						//	Exit.
   456 						rts
   457 2136			cont
   458 					ldy	#1
   459 					NUtils.movba	"(tbl_ptr),y", tmp_ptr
   460 					iny
   461 					NUtils.movba	"(tbl_ptr),y", tmp_ptr+1
   462
   463 					//	Copy the first byte.
   464 					ldy	#3
   465 					lda	(tbl_ptr),y
   466 					ldy	#0
   467 					sta	(tmp_ptr),y
   468 					
   469 					//	if	(tbl_ptr[0] == EType.BYTE)
   470 					//ldy	#0
   471 					NUtils.cmpba	"(tbl_ptr),y", #EType.BYTE
   472 					bne	cont_2
   473 						NUtils.addbw	tbl_ptr, #4, tbl_ptr
   474 						jmp	loop
   475 					
   476 2136			cont_2
   477 					//	if	(tbl_ptr[0] == EType.WORD)
   478 					//ldy	#0
   479 					NUtils.cmpba	"(tbl_ptr),y", #EType.WORD
   480 					bne	cont_3
   481 						//	Copy second byte.
   482 						ldy	#4
   483 						lda	(tbl_ptr),y
   484 						ldy	#1
   485 						sta	(tmp_ptr),y
   486 						
   487 						NUtils.addbw	tbl_ptr, #5, tbl_ptr
   488 						jmp	loop
   489 					
   490 2136			cont_3
   491 					jmp	loop
   492 				.endp
   493
