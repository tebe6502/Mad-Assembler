    74 				///	Initialize system keycode.
    75 215F			.proc	init_keycode
    76 					NUtils.movba	#KEYCODE_NONE, NSystem.CH
    77 					rts
    78 				.endp
    79
    80 				//******************************************************************************************************************************************************
    81
    82 				///	Wait for key pressed.
    83 				/**	@param .byte A	Result.
    84 				*/
    84
    85 215F			.proc	wait_for_key_pressed
    86 215F				.using	NIO
    87
    88 					jsr	find_first_free_iocb_channel
    89 					bmi	_error
    90
    91 					NUtils.leaw	kbd_dev_str, "ICBUFA,x"
    92 					NUtils.movba	#$04, "ICAX1,x"
    93 					NUtils.movba	#$00, "ICAX2,x"
    94 					lda #$03
    95 					jsr cio_exe
    96 					bmi	_error	// w dobrze zdebugowanym programie raczej nie wyst¹pi tu b³¹d
    97
    98 					lda #$00
    99 					sta ICBUFL,x
   100 					sta ICBUFL+1,x
   101 					lda #$07
   102 					jsr cio_exe
   103 					bmi _error	// np. naciœniêto Break
   104
   105 					pha
   106 					lda #$0c
   107 					jsr cio_exe
   108 					pla
   109 					rts
   110
   111 215F			_error
   112 					rts
   113
   114 215F			cio_exe
   115 					sta ICCMD,x
   116 					jmp CIOV
   117 				.endp
   118
   119 				//******************************************************************************************************************************************************
   120
   121 				///	GETLINE.
   122 				/**	Program czeka, az uzytkownik wpisze ciag znaków z klawiatury i nacisnie klawisz RETURN.
   123 					Znaki podczas wpisywania sa wyswietlane na ekranie, dzialaja tez normalne znaki kontrolne
   124 					(odczyt jest robiony z edytora ekranowego). 
   125
   126 					Wywolanie funkcji polega na zaladowaniu adresu, pod jaki maja byc wpisane znaki,
   127 					do rejestrów A/Y (mlodszy/starszy) i wykonaniu rozkazu JSR GETLINE. Konczacy znak to $9b.
   128 				*/
   128
   129 215F			.proc	get_line(.word ya) .reg
   130 215F				.using NIO
   131 					
   132 					ldx	#$00
   133 					sta	ICBUFA+0,x
   134 					tya
   135 					sta	ICBUFA+1,x
   136
   137 					NUtils.movba	#MAX_STR_LEN, "ICBUFL,x"
   138 					NUtils.movba	#$05, "ICCMD,x"
   139 					
   140 					jmp	CIOV
   141 				.endp
   142
   143 				//******************************************************************************************************************************************************
   144
   145 				///	Convert byte into lowercase, hexadecimal ATASCII string.
   146 				/**	@param .byte value	Value to convert.
   147 					@param .word dst_ptr	Pointer to destination buffer.
   148 				*/
   148
   149 215F			.proc	bta(.byte value .word ptr) .var
   150 					value	= NConsole.value
   151 					ptr 	= NConsole.ptr
   152
   153 					lda	value
   154 					NUtils.lsra	4
   155 					tax
   156 					
   157 					ldy	#0
   158 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   159 					
   160 					NUtils.andba	value, #$0f
   161 					tax
   162 					iny
   163 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   164
   165 					//	Terminating NULL
   166 					iny
   167 					NUtils.movba	#0, "(ptr),y"
   168 					rts
   169 				.endp
   170
   171 				//******************************************************************************************************************************************************
   172
   173 				///	Convert byte to decimal ATASCII string.
   174 				/**	@param	.byte	value	- Number to convert.
   175 				*/
   175
   176 				/*.proc	wtod( .word value .word dst_ptr ) .var
   177 					.var	.word	value
   178 					dst_ptr = NConsole.dst_ptr
   179 					
   180 					_itofp	value, #fp
   181 					_fptoa	#fp, dst_ptr
   182 					NAlgorithm.find_first_of	dst_ptr, #$9b
   183 					NUtils.movba	#0, "(dst_ptr),y"
   184 					rts
   185
   186 					fp:	.ds 6	//	FP0 number buffer
   187 				.endp*/
   187
   188
