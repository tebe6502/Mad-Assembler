   101
   102 				///	Set memory. Uses code auto-modification.
   103 				/**	@param .word %%1	Destination location.
   104 					@param .word %%2	Count.
   105 					@param .byte %%3	Value.
   106 				*/
   106
   107 20AD			.proc	memset(.word dst_ptr .word count .byte value) .var
   108 					dst_ptr	= NMemory.ptr
   109 					count	= NMemory.count
   110 					value	= NMemory.value
   111 					
   112 					ldx	value
   113 					ldy	#0
   114 20AD			loop
   115 					//	Test, whether we are done or not.
   116 					NUtils.tstzw	count
   117 					beq	done
   118 						txa
   119 						sta	(dst_ptr),y
   120 					
   121 					NUtils.decw	count
   122 					iny
   123 					bne	loop
   124 					
   125 					inc	dst_ptr+1
   126 					jmp	loop
   127 20AD			done
   128 					rts
   129 				.endp
   130
   131 				//******************************************************************************************************************************************************
   132
   133 				///	Set memory. Range restricted to one page only. Uses code auto-modification.
   134 				/**	@param .word dst_ptr	Destination pointer. Should be page aligned to achieve best performance.
   135 					@param .byte count	Count.
   136 					@param .byte value	Value.
   137 				*/
   137
   138 20AD			.proc	memsetp(.word dst_ptr .byte count .byte value) .var
   139 					value = * + 1
   140 						lda	#0
   141 					count = * + 1	// auto-modification
   142 						ldy	#0
   143 20AD			loop
   144 					dey
   145 					dst_ptr	= * + 1
   146 						sta	$ffff,y	// auto-modification
   147 					bne	loop
   148 					rts
   149 				.endp
   150
   151 				//******************************************************************************************************************************************************
   152
   153 				///	Set 2D table. Uses code auto-modification.
   154 				/**	@param .word %%1	- Destination location.
   155 					@param .byte %%2	- Width.
   156 					@param .word %%3	- Modulo.
   157 					@param .byte %%4	- Height.
   158 					@param .byte %%5	- Value.
   159 				*/
   159
   160 20AD			.proc	memsetm(.word dst_ptr .byte width .word modulo .byte height .byte value) .var
   161 					dst_ptr = NMemory.ptr
   162 					width = NMemory.width
   163 					modulo = NMemory.modulo
   164 					height = NMemory.height
   165 					value	= NMemory.value
   166
   167 					ldx	height
   168 20AD			loop2
   169 					ldy	#0
   170 					lda	value
   171 20AD			loop
   172 					sta	(dst_ptr),y
   173 					iny
   174 					cpy	width
   175 					bne	loop
   176 					
   177 					NUtils.addw	dst_ptr, modulo, dst_ptr
   178 					dex
   179 					bne	loop2
   180 					rts
   181 				.endp
