   190 				//	Data
   191 				//******************************************************************************************************************************************************
   192 					
   193 215F 4B 3A 9B			kbd_dev_str:  dta c'K:', ATASCII_EOL
   194 2162 30 31 32 33 34 35 + 	hex_to_atascii_tbl:	dta c'0123456789ABCDEF'
   195 2172 10 11 12 13 14 15 + 	hex_to_internal_tbl:	dta d'0123456789ABCDEF'
   196
   197 				//******************************************************************************************************************************************************
   198
   199 = 0084			ptr
   199 = 2182 00		value
