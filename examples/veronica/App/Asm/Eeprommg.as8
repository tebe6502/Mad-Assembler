	locations_str:	dta c'I'*,'nternal, ','E'*,'xternal: ', 0
	sources_str:	dta c'P'*,'rimary, ','S'*,'econdary, Boo','t'*,': ', 0
	source_key_codes:	dta c'PST', $ff
	location_key_codes:	dta c'IE', $ff

	bkp_abbrev_str:	dta c'Backup', 0
	prg_abbrev_str:	dta c'Programm', 0
	exit_abbrev_str:	dta c'Quit', 0
	int_abbrev_str:	dta c'Internal', 0
	ext_abbrev_str:	dta c'External', 0
	//back_abbrev_str:	dta c'Back', 0
