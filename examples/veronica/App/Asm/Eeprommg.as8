//******************************************************************************************************************************************************

.proc	identify_gui( .byte bios_location .byte bios_type ) .var
	show_diagnostics	bios_location, bios_type
	bne	continue
		rts

continue
	NVeronica.NMaster.retrieve_bios	bios_location, bios_type, #bios_ptr

	ldy	#SBIOSHeader.m_size
	NUtils.movba	"(bios_ptr),y", bios_size+0
	iny
	NUtils.movba	"(bios_ptr),y", bios_size+1

	NVeronica.NMaster.get_bios_size_limitation	bios_type, #bios_size_limit
	
	NUtils.subw	bios_size_limit, bios_size
	bcs	limit_ok
		NConsole.print	#invalid_bios_size_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		rts

limit_ok
	show_veronica_bios_version	bios_ptr
	rts
.endp

//******************************************************************************************************************************************************

.proc	wait_for_key_pressed( .byte key ) .var
	.var	.byte	key
	
loop
	NConsole.wait_for_key_pressed
	cmp	key
	bne	loop
	rts
.endp

//******************************************************************************************************************************************************

///	Shows diagnostic messages.
/**	@param .byte bios_location	Bios location.
	@param .byte bios_type	Bios type.
	@return .byte A	Exit Status.
*/
.proc	show_diagnostics( .byte bios_location .byte bios_type ) .var
	.var .byte	status
	
	NUtils.cmpba	bios_location, #EBIOSLocation.INTERNAL
	bne	external
		NVeronica.NMaster.identify	#NVeronica.NProtocol.IDENTIFY_CMD_TIMEOUT
		sta	status
		show_veronica_detection_str	status
		NConsole.putc	#'.'
		lda	status
		beq	no_detection
			NConsole.putc	#$9b
			lda	#NUtils.TRUE
			rts

	no_detection:
		NConsole.putc	#' '
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		lda	#NUtils.FALSE
		rts

external
	NConsole.println	#int_eeprom_rambank_placement_str
	lda	#NUtils.TRUE
	rts
.endp

//******************************************************************************************************************************************************

///	Execute procedure on key pressed.
/**	@param .byte key_code		- ATASCII key code.
	@param .word key_codes_ptr	- Pointer to the key codes table.
	@param .word procedures_ptr	- Pointer to the procedure pointers table.
	@return .bool A	- Status.
		#FALSE	- No match found.
		#TRUE 	- Match found. Procedure executed.
*/
.proc	execute_proc_on_keymatched( .byte key_code .word key_codes_ptr .word procedures_ptr ) .var
	.zpvar	.word	key_codes_ptr, procedures_ptr
	.var	.byte	key_code
	
	ldy	#0
loop
	NUtils.cmpba	"(key_codes_ptr),y", #$ff
	beq	_exit
	NUtils.cmpba	key_code, "(key_codes_ptr),y"
	beq	found
	iny
	bne	loop

_exit
	lda	#NUtils.FALSE
	rts
	
found
	tya
	asl	@
	tay
	NUtils.movba	"(procedures_ptr),y", jsr_vct+0
	iny
	NUtils.movba	"(procedures_ptr),y", jsr_vct+1
	
	jsr_vct = * + 1
	jsr $ffff
	
	lda	#NUtils.TRUE
	rts
.endp

//******************************************************************************************************************************************************

.proc	show_veronica_detection_str( .byte a ) .reg
	and	#1
	asl	@
	tax
	NUtils.movba	"strings+0,x", NConsole.println.ptr+0
	NUtils.movba	"strings+1,x", NConsole.println.ptr+1
	jmp	NConsole.print
	
	strings:	dta a(no_detection_str, detected_str)
.endp

//******************************************************************************************************************************************************

.proc	show_veronica_bios_version( .word bios_ptr ) .var
	NConsole.print	#bios_ver_str
	
	ldy	#SBIOSHeader.m_version.m_major
	jsr	print_dec_byte
	NConsole.putc	#'.'
	
	ldy	#SBIOSHeader.m_version.m_minor
	jsr	print_dec_byte
	NConsole.putc	#'.'
	
	ldy	#SBIOSHeader.m_version.m_maintenance
	jsr	print_dec_byte
	NConsole.putc	#'.'
	
	ldy	#SBIOSHeader.m_version.m_build
	jsr	print_dec_byte
	NConsole.putc	#$9b
	
	NConsole.print	#bios_size_str
	ldy	#(SBIOSHeader.m_size+1)
	jsr	print_hex_byte
	
	ldy	#(SBIOSHeader.m_size+0)
	jsr	print_hex_byte
	NConsole.putc	#$9b
	
	NConsole.print	#bios_startup_str
	ldy	#(SBIOSHeader.m_code_ptr+1)
	jsr	print_hex_byte
	
	ldy	#(SBIOSHeader.m_code_ptr+0)
	jsr	print_hex_byte
	NConsole.putc	#$9b
	rts
	
print_hex_byte
	NUtils.movba	"(bios_ptr),y", NConsole.bta.value
	NUtils.leaw	tmp_buf, NConsole.bta.ptr
	jsr	NConsole.bta
	NConsole.print	#tmp_buf
	rts

print_dec_byte
	NUtils.movba	"(bios_ptr),y", NUtils.wtod.value+0
	NUtils.movba	#0, NUtils.wtod.value+1
	NUtils.leaw		tmp_buf, NUtils.wtod.dst_ptr
	jsr	NUtils.wtod
	NConsole.print	#tmp_buf
	rts

	tmp_buf:	dta c'....'
	fp:	.ds 6	//	bufor na liczbe FP0
.endp

//******************************************************************************************************************************************************
//	Data
//******************************************************************************************************************************************************

	filepath_buf:	.ds	128
	error_num_str:	.ds	4

