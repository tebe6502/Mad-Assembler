.proc	external_backup_proc
	NConsole.println	#ext_abbrev_str
loop
	NConsole.print	#sources_str
int_loop
	NConsole.wait_for_key_pressed
	sta	key_code
	execute_proc_on_keymatched	key_code, #source_key_codes, #proc_ptrs
	beq	int_loop
	rts
	
	proc_ptrs:	dta a(ext_pri_bkp_proc, ext_sec_bkp_proc, ext_boot_bkp_proc/*, back_proc*/)
.endp

//******************************************************************************************************************************************************

.proc	int_pri_bkp_proc
	NConsole.println	#pri_abbrev_str
	backup_gui	#EBIOSLocation.INTERNAL, #EBIOSType.PRIMARY
	rts
.endp

//******************************************************************************************************************************************************

.proc	int_sec_bkp_proc
	NConsole.println	#sec_abbrev_str
	backup_gui	#EBIOSLocation.INTERNAL, #EBIOSType.SECONDARY
	rts
.endp

//******************************************************************************************************************************************************

.proc	int_boot_bkp_proc
