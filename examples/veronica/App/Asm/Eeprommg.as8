	backup_gui	#EBIOSLocation.INTERNAL, #EBIOSType.BOOTSTRAP
	rts
.endp

//******************************************************************************************************************************************************

.proc	ext_pri_bkp_proc
	NConsole.println	#pri_abbrev_str
	backup_gui	#EBIOSLocation.EXTERNAL, #EBIOSType.PRIMARY
	rts
.endp

//******************************************************************************************************************************************************

.proc	ext_sec_bkp_proc
	NConsole.println	#sec_abbrev_str
	backup_gui	#EBIOSLocation.EXTERNAL, #EBIOSType.SECONDARY
	rts
.endp

//******************************************************************************************************************************************************

.proc	ext_boot_bkp_proc
	NConsole.println	#boot_abbrev_str
	backup_gui	#EBIOSLocation.EXTERNAL, #EBIOSType.BOOTSTRAP
	rts
.endp

//******************************************************************************************************************************************************

.proc	backup_gui( .byte bios_location .byte bios_type ) .var
	show_diagnostics	bios_location, bios_type
	bne	continue
		rts

continue
	NVeronica.NMaster.retrieve_bios	bios_location, bios_type, #bios_ptr
	
	ldy	#SBIOSHeader.m_size
	NUtils.movba	"(bios_ptr),y", bios_size+0
	iny
	NUtils.movba	"(bios_ptr),y", bios_size+1

	NVeronica.NMaster.get_bios_size_limitation	bios_type, #bios_size_limit
	
	NUtils.subw	bios_size_limit, bios_size
	bcs	limit_ok
		NConsole.print	#invalid_bios_size_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		rts

limit_ok
	show_veronica_bios_version	bios_ptr
	
	NConsole.print	#enter_filepath_str
	NConsole.get_line	#filepath_buf
	
	NConsole.print	#saving_str
	NConsole.println	#dot_str

	NIO.open	#(IOCB_CHANNEL*16), #8, #filepath_buf
	bpl	open_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
	
open_ok
	NIO.execute_command	#(IOCB_CHANNEL*16), #11, bios_ptr, bios_size
	bpl	command_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
	
command_ok
	NIO.close	#(IOCB_CHANNEL*16)
	
	NConsole.print	#done_str
	NConsole.println	#dot_str
	rts
.endp

//******************************************************************************************************************************************************

/*.proc	back_proc
	NConsole.println	#back_abbrev_str
	pla
	pla
	pla
	pla
	rts
.endp*/

