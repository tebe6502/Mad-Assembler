//******************************************************************************************************************************************************

.proc	programm_gui( .byte bios_location .byte bios_type ) .var
	NUtils.leaw	Input_BIOS_Ptr, bios_ptr
	show_diagnostics	bios_location, bios_type
	bne	continue
		rts

continue
	NConsole.print	#enter_filepath_str
	NConsole.get_line	#filepath_buf
	
	//	Reading BIOS header.
	NConsole.print	#reading_bios_header_str
	NConsole.println	#dot_str

	NIO.open	#(IOCB_CHANNEL*16), #4, #filepath_buf
	bpl	header_open_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
	
header_open_ok
	NIO.execute_command	#(IOCB_CHANNEL*16), #7, bios_ptr, #.len(SBIOSHeader)
	bpl	header_command_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
	
header_command_ok
	NIO.close	#(IOCB_CHANNEL*16)
	
	ldy	#SBIOSHeader.m_size
	NUtils.movba	"(bios_ptr),y", bios_size+0
	iny
	NUtils.movba	"(bios_ptr),y", bios_size+1
	
	NVeronica.NMaster.get_bios_size_limitation	bios_type, #bios_size_limit
	
	NUtils.subw	bios_size_limit, bios_size
	bcs	limit_ok
		NConsole.print	#invalid_bios_size_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		rts
		
limit_ok
	show_veronica_bios_version	bios_ptr
	
	//	Reading entire BIOS.
	NConsole.print	#reading_bios_data_str
	NConsole.println	#dot_str

	NIO.open	#(IOCB_CHANNEL*16), #4, #filepath_buf
	bpl	bios_open_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
		
bios_open_ok
	NIO.execute_command	#(IOCB_CHANNEL*16), #7, bios_ptr, bios_size
	bpl	bios_command_ok
		sty	error_code+0
		NConsole.print	#error_str
		NUtils.wtod	error_code, #error_num_str
		NConsole.putc	#' '
		NConsole.print	#error_num_str
		NConsole.print	#dot_space_str
		NConsole.print	#breaking_str
		NConsole.println	#dot_str
		NIO.close	#(IOCB_CHANNEL*16)
		rts
		
bios_command_ok
	NIO.close	#(IOCB_CHANNEL*16)

	//	proceed_or_terminate();
	NUtils.cmpba	bios_location, #EBIOSLocation.INTERNAL
	bne	extp
		internal_programming	bios_type, bios_ptr
		jmp	finish
extp
		external_programming	bios_type, bios_ptr
		jmp	finish
		
finish
	NConsole.print	#finished_str
	NConsole.println	#dot_str
	rts
.endp

//******************************************************************************************************************************************************

.proc	internal_programming( .byte bios_type .word bios_ptr ) .var
	.var	.word	dst_bios_ptr
	.var	.byte	delay

	jsr	NVeronica.NMaster.get_eeprom_switch_status
	bne	ready_to_write
		NConsole.print	#switch_to_write_enable_str
		NConsole.putc	#'.'
		jsr	NVeronica.NMaster.wait_for_eeprom_switch_write_enabled
		NConsole.putc	#' '
		NConsole.print		#switched_str
		NConsole.println	#dot_str
	
ready_to_write
	//	Calculate half a second delay.
	jsr	NSystem.get_tv_fps
	lsr	@
	sta	delay
	
	NSystem.wait_for_vbl	delay
	
	ldy	#SBIOSHeader.m_size
	NUtils.movba	"(bios_ptr),y", bios_size+0
	iny
	NUtils.movba	"(bios_ptr),y", bios_size+1
	
	NVeronica.NMaster.get_bios_address	#EBIOSLocation.INTERNAL, bios_type, #dst_bios_ptr
		
	//	First, transfer the new EEPROM data.
	NVeronica.NMaster.execute_data_upload_cmd	bios_ptr, bios_size, #N6502K.Ver_Tmp_BIOS_Ptr
	jsr	NVeronica.NMaster.wait_for_6502K
	NConsole.print	#data_upload_str
	NConsole.println	#dot_str
	
	//	Second, the programming routine.
	NVeronica.NMaster.execute_data_upload_cmd	#N6502K.CODE_SECTION_BEGIN, #N6502K.CODE_LENGTH, #N6502K.Code_Ptr
	jsr	NVeronica.NMaster.wait_for_6502K
	NConsole.print	#data_upload_str
	NConsole.println	#dot_str
	
	//	Third, the programming routine's params.
	.var NVeronica.NEEPROMProgramming.SEEPROMWriteParams	params
	
	NUtils.leaw	N6502K.Ver_Tmp_BIOS_Ptr, params.m_src_rom_ptr
	NUtils.movw	bios_size, params.m_rom_size
	NUtils.movw	dst_bios_ptr, params.m_dst_rom_ptr

	NVeronica.NMaster.execute_data_upload_cmd	#params, #.len(NVeronica.NEEPROMProgramming.SEEPROMWriteParams), #N6502K.Zpg_Variables_Ptr
	jsr	NVeronica.NMaster.wait_for_6502K
	NConsole.print	#data_upload_str
	NConsole.println	#dot_str
	
	NConsole.print	#programming_str
	NConsole.putc	#'.'
	
	//	Execute the programming procedure.
	NVeronica.NMaster.execute_procedure_call_cmd	#N6502K.Entry_Proc_Ptr
	jsr	NVeronica.NMaster.wait_for_6502K

	//	Write startup vector
	NUtils.cmpba	bios_type, #EBIOSType.BOOTSTRAP
	bne	no_bootstrap
		NUtils.movw	bios_ptr, params.m_src_rom_ptr
		NUtils.leaw	2, params.m_rom_size
		NUtils.leaw	CPU_Startup_Ptr, params.m_dst_rom_ptr

		NVeronica.NMaster.execute_data_upload_cmd	#params, #.len(NVeronica.NEEPROMProgramming.SEEPROMWriteParams), #N6502K.Zpg_Variables_Ptr
		jsr	NVeronica.NMaster.wait_for_6502K
		//	Execute the programming procedure.
		NVeronica.NMaster.execute_procedure_call_cmd	#N6502K.Entry_Proc_Ptr
		jsr	NVeronica.NMaster.wait_for_6502K
	
no_bootstrap
	NConsole.putc	#' '
	NConsole.print	#done_str
	NConsole.println	#dot_str
	
	//	Switch EPROM writing to disabled.
	NConsole.print	#switch_to_write_disabled_str
	NConsole.putc	#'.'
	jsr	NVeronica.NMaster.wait_for_eeprom_switch_write_disabled
	NSystem.wait_for_vbl	delay
	NConsole.putc	#' '
	NConsole.print	#switched_str
	NConsole.println	#dot_str
	
	rts
.endp

//******************************************************************************************************************************************************

.proc	external_programming( .byte bios_type .word bios_ptr ) .var
	.var	.word	dst_bios_ptr
	
	NConsole.print	#switch_to_write_enable_str
	NConsole.print	#dot_space_str
	NConsole.print	#done_str
	NConsole.putc	#' '
	NConsole.putc	#'?'
	NConsole.putc	#' '
	wait_for_key_pressed	#'Y'
	NConsole.putc	#'Y'*
	NConsole.putc	#$9b
	
	NConsole.print	#programming_str
	NConsole.println	#dot_str
	
	ldy	#SBIOSHeader.m_size
	NUtils.movba	"(bios_ptr),y", bios_size+0
	iny
	NUtils.movba	"(bios_ptr),y", bios_size+1
	
	NVeronica.NMaster.get_bios_address	#EBIOSLocation.EXTERNAL, bios_type, #dst_bios_ptr
	NVeronica.NMaster.set_rambank	#0
	NVeronica.NMaster.eeprom_write	bios_ptr, bios_size, dst_bios_ptr

	NUtils.cmpba	bios_type, #EBIOSType.BOOTSTRAP
	bne	no_bootstrap
		.var	.word	startup_offset, startup_ptr
		
		NUtils.leaw	SBIOSHeader.m_code_ptr, startup_offset
		NUtils.addw	bios_ptr, startup_offset, startup_ptr
		NVeronica.NMaster.eeprom_write	startup_ptr, #2/*.len(.word)*/, #(CPU_Startup_Ptr-NVeronica.NEEPROMProgramming.VERONICA_TO_ATARI_EEPROM_OFFSET)
	
no_bootstrap
	NConsole.print	#switch_to_write_disabled_str
	NConsole.print	#dot_space_str
	NConsole.print	#done_str
	NConsole.putc	#' '
	NConsole.putc	#'?'
	NConsole.putc	#' '
	wait_for_key_pressed	#'Y'
	NConsole.putc	#'Y'*
	NConsole.putc	#$9b
	rts
.endp

//******************************************************************************************************************************************************

