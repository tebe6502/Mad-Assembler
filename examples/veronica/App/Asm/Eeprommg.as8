	pri_abbrev_str:	dta c'Primary', 0
	sec_abbrev_str:	dta c'Secondary', 0
	boot_abbrev_str:	dta c'Boot', 0

	bios_ver_str:		dta c'BIOS version: ', 0
	bios_size_str:		dta c'BIOS size:    $', 0
	bios_startup_str:	dta c'BIOS startup: $', 0
	
	int_eeprom_rambank_placement_str:	dta c'Assuming EEPROM under $8000', 0
	invalid_bios_size_str:	dta c'Invalid BIOS size', 0
	reading_bios_header_str:	dta c'Reading BIOS header', 0
	reading_bios_data_str:	dta c'Reading BIOS data', 0
	switch_to_write_enable_str:		dta c'Switch to write enable', 0
	switch_to_write_disabled_str:	dta c'Switch to write disabled', 0
	data_upload_str:	dta c'Successful data upload', 0
	code_execuction_str:	dta c'Successful code execution', 0
	
	exit_str:	dta c'Exiting', 0
	enter_filepath_str:	dta c'Enter filepath: ', 0
	breaking_str:	dta c'Breaking', 0
	reading_str:	dta c'Reading', 0
	programming_str:	dta c'Programming', 0
	saving_str:	dta c'Saving', 0
	error_str:	dta c'Error', 0
	finished_str:	dta c'Finished', 0
	switched_str:	dta c'Switched', 0
	done_str:	dta c'Done', 0
	
	dot_space_str:	dta c'. ', 0
			
.endl // NEEPROM_Manager
	
