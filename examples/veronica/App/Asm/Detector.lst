   203 267F				icl	'Utils\fp.asm'
     1
     2 				/*
     3 				   Przykladowa biblioteka wykorzystujaca pakiet matematyczny XE/XL
     4
     5 				   _ATOFP (ascii,fp)	- zamienia ciag znakow ASCII na liczbe FP, pierwszy parametr to adres ciagu ASCII ktory bedzie
     6 							  zamieniany na FP, drugi parametr to adres pod którym odlozona zostanie liczba FP
     7 				   			  zamieniany ciag ASCII musi byc zakonczony znakiem innym niz cyfra, np. EOL $9B
     8
     9 				   _FPTOA (fp,ascii)	- zamienia liczbe FP na ciag znakow ASCII, pierwszy parametr to adres pod którym znajduje
    10 							  sie liczba FP, drugi parametr to adres pod ktory odlozony zostanie ciag znaków ASCII
    11 							  ciag ASCII bedzie zakonczony znakiem EOL $9b
    12
    13 				   _ITOFP (int,fp)	- zamienia liczbe typu 'unsigned int' (word) na liczbe FP, pierwszym parametrem jest wartosc
    14 							  bez znaku z zakresu 0..$FFFF, drugim parametrem jest adres pod którym zostanie zapisana
    15 							  liczba FP
    16
    17 				   _FPTOI (fp)		- zamienia liczbe FP na liczbe typu 'unsigned int' (word), parametrem jest adres pod
    18 							  ktorym znajduje sie liczba FP, wynik zwracany jest przez rejestry CPU X,Y
    19 							  X - mlodszy bajt liczby WORD
    20 							  Y - starszy bajt liczby WORD
    21
    22 				   _FPADD (fp0,fp1,fp2)	- FP2=FP0+FP1	suma dwóch liczb
    23
    24 				   _FPSUB (fp0,fp1,fp2)	- FP2=FP0-FP1	róznica dwóch liczb
    25
    26 				   _FPMUL (fp0,fp1,fp2)	- FP2=FP0*FP1	iloczyn dwóch liczb
    27
    28 				   _FPDIV (fp0,fp1,fp2)	- FP2=FP0/FP1	iloraz dwóch liczb
    29
    30 				   LOADFR0 (fp)		- przepisuje liczbe FP do rejestru pakietu zmiennoprzecinkowego FR0, parametrem
    31 				   			  jest adres pod ktorym znajduje sie liczba FP do przepisania
    32
    33 				   LOADFR1 (fp)		- przepisuje liczbe FP do rejestru pakietu zmiennoprzecinkowego FR1, parametrem
    34 				   			  jest adres pod ktorym znajduje sie liczba FP do przepisania
    35
    36 				*/
    36
