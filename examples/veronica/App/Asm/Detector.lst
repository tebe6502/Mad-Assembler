    88 					jsr	find_first_free_iocb_channel
    89 					bmi	_error
    90
    91 					NUtils.leaw	kbd_dev_str, "ICBUFA,x"
    92 					NUtils.movba	#$04, "ICAX1,x"
    93 					NUtils.movba	#$00, "ICAX2,x"
    94 					lda #$03
    95 					jsr cio_exe
    96 					bmi	_error	// w dobrze zdebugowanym programie raczej nie wyst¹pi tu b³¹d
    97
    98 					lda #$00
    99 					sta ICBUFL,x
   100 					sta ICBUFL+1,x
   101 					lda #$07
   102 					jsr cio_exe
   103 					bmi _error	// np. naciœniêto Break
   104
   105 					pha
   106 					lda #$0c
   107 					jsr cio_exe
   108 					pla
   109 					rts
   110
   111 236A			_error
   112 					rts
   113
   114 236A			cio_exe
   115 					sta ICCMD,x
   116 					jmp CIOV
   117 				.endp
