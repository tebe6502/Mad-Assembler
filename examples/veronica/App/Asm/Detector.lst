    32 22A6				.local	full_pages
    33 22A6				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 22A6				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 22A6				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 22A6			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 22A6			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
