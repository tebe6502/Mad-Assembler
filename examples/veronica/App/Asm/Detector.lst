    63 267F			_fptoa	.proc	(.word loadfr0.adr, ptr1) .var
    64
    65 267F 20 C8 26			jsr	loadfr0
    66
    67 2682 A9 00			lda     #0
    68 2684 85 F2			sta     cix
    69
    70 2686 A9 80 85 F3 A9 05 + 	mwa	#lbuff	inbuff	; COPY ADDRESS OF LBUFF INTO INBUFF
    71 					
    72 268E 20 E6 D8			jsr     fasc
    73 2691 A0 FF			ldy     #$FF
    74 2693 C8			loop:	iny
    75 2694 B1 F3			lda     (inbuff),y
    76 2696 91 D2			sta     (ptr1),y
    77 2698 10 F9			bpl     loop
    78 269A 29 7F			and     #$7F
    79 269C 91 D2			sta     (ptr1),y
    80 269E C8				iny
    81 269F A9 9B			lda     #$9b
    82 26A1 91 D2			sta     (ptr1),y
    83 26A3 60				rts
    84
    85 					.endp
