   355 266F			.proc	fract_u16_r16
   356 					.macro	fract_u16_r16_macro
   357 						txa	// 2
   358 						asl	@ // 2
   359 						rol math_arg0+1 // 5
   360 						bcs	skip1 // 3, 2
   361 				
   362 						sta	math_arg0 // 3
   363 						sbc	math_arg1+2 // 3
   364 						tax // 2
   365 						lda	math_arg0+1 // 3
   366 						sbc	math_arg1+3 // 3
