    30 2354 20 5D 23				jsr	putc
    31 2357					NUtils.popy
Macro: NUtils.popy [Source: utils.as8]
     1 2357 68			    pla
     2 2358 A8			    tay
Source: console.as8
    32 2359 C8				iny
    33 235A D0 F0			bne	loop
    34 					
    35 235C			_exit
    36 235C 60				rts
    37 				.endp
