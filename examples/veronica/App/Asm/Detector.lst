    79 22A6 A0 FF				ldy	#$ff
    80 22A8 88				dey
    81 22A9			loop
    82 = 22AA				tbl0_ptr = *+1
    83 22A9 B9 FF FF				lda	$ffff,y
    84 = 22AD				tbl1_ptr = *+1
    85 22AC D9 FF FF				cmp	$ffff,y
    86 22AF D0 06			bne	inequality
    87 					
    88 22B1 88				dey
    89 22B2 10 F5			bpl	loop
    90 					
    91 					//	equality
    92 22B4 A9 01			lda	#NUtils.TRUE
    93 22B6 60				rts
    94
    95 22B7			inequality
    96 22B7 A9 00			lda	#NUtils.FALSE
    97 22B9 60				rts
    98 				.endp
