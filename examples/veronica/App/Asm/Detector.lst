    95 				    sta	tmp_mul_vct1+0
    96 				    ldy	#$fe
    97 				    sta	(tmp_mul_vct2),y
    98 				    sta	(tmp_mul_vct3),y
    99
   100 					ldx	#$ff
   101 					stx	tmp
   102 					inx
   103 					
   104 25FD			loop1
   105 					lda	#$fe
   106 					sta	tmp_mul_vct2+0
   107 					sta	tmp_mul_vct3+0
   108 						
   109 					txa
   110 					tay
   111 					lsr	@
   112 					clc
