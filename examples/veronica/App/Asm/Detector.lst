   115 					inc	tmp_mul_vct2+0
   116 					sta	(tmp_mul_vct2),y
   117 					ldy	#0
   118 					sty	tmp_mul_vct2+0
   119 					ldy	tmp
   120 					sta	(tmp_mul_vct2),y
   121 						
   122 					txa
   123 					tay
   124 					lda	#0
   125 					adc	(tmp_mul_vct3),y
   126 					sta	(tmp_mul_vct1),y
   127 					inc	tmp_mul_vct3+0
   128 					sta	(tmp_mul_vct3),y
