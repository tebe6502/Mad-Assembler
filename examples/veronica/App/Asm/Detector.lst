   133
   134 					dec	tmp
   135 					inx
   136 					bne	loop1
   137
   138 25FD			loop2
   139 					ldy	#$ff
   140 					sty	tmp_mul_vct0+0
   141 					sty	tmp_mul_vct1+0
   142 						
   143 					txa
   144 					tay
   145 					sec
   146 					ror	@
   147 					clc
   148 					adc	(tmp_mul_vct0),y
   149 					inc	tmp_mul_vct0+0
   150 					inc	tmp_mul_vct0+1
   151 					sta	(tmp_mul_vct0),y
