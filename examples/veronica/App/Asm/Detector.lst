    43 				//******************************************************************************************************************************************************
    44
    45 				///	Generate random values.
    46 				/**	@param .word ptr	Random variable pointer.
    47 				*/
    47
    48 25FD			.proc	rand(.word ptr) .var
    49 					ptr	= NMaths.ptr
    50
    51 					ldy	#SRandomNumber.m_byte_a
    52 					lda	(ptr),y
    53 					ldy	#SRandomNumber.m_byte_b
    54 					eor	(ptr),y
    55 					asl	@
    56 					ldy	#SRandomNumber.m_byte_a
    57 					sta	(ptr),y
    58 					
    59 					ldy	#SRandomNumber.m_byte_b
    60 					lda	(ptr),y
    61 					ldy	#SRandomNumber.m_byte_c
    62 					adc	(ptr),y
    63 					ldy	#SRandomNumber.m_byte_b
    64 					sta	(ptr),y
    65 					
    66 					ldy	#SRandomNumber.m_byte_c
    67 					lda	(ptr),y
    68 					ldy	#SRandomNumber.m_byte_b
    69 					eor	(ptr),y
    70 					ldy	#SRandomNumber.m_byte_c
    71 					sta	(ptr),y
    72 					rts
    73 				.endp
