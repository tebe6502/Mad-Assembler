    28 				///	Initialize random variable.
    29 				/**	@param .word ptr	Random variable pointer.
    30 				*/
    30
    31 25FD			.proc	srand(.word ptr) .var
    32 					ptr	= NMaths.ptr
    33 					
    34 					ldy	#SRandomNumber.m_byte_a
    35 					NUtils.movba	#ERandomGeneratorDefaults.DEF_BYTE_A, "(ptr),y"
    36 					ldy	#SRandomNumber.m_byte_b
    37 					NUtils.movba	#ERandomGeneratorDefaults.DEF_BYTE_B, "(ptr),y"
    38 					ldy	#SRandomNumber.m_byte_c
    39 					NUtils.movba	#ERandomGeneratorDefaults.DEF_BYTE_C, "(ptr),y"
    40 					rts
    41 				.endp
