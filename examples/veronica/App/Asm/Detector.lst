   201 25EB				icl	'algorithm.as8'
Source: algorithm.as8
     1 25EB			.local	NAlgorithm
     2
     3 				//******************************************************************************************************************************************************
     4 				//	Code
     5 				//******************************************************************************************************************************************************
     6
     7 				///	Locates position of the first occurrence of an element in a page that has a specified value.
     8 				/**	@param .word ptr	Pointer to the first element.
     9 					@param .byte value	Value to search for.
    10 					@return .bool A	Status.
    11 						NUtils.TRUE		- Found.
    12 						NUtils.FALSE	- Not found.
    13 					@return .byte Y	- Offset.
    14 				*/
    14
    15 25EB			.proc	find(.word ptr .byte value) .var
    16 25EB A0 00			ldy	#0
    17 25ED			loop
    18 = 25EE				ptr = * + 1
