  1189 				/// for equality. Modifies: A, Flags.
  1190 				/** @param .word %%1    Argument.
  1191 				    @param .word %%2    Argument.
  1192 				*/
  1192
  1193 				.macro  tstweq
  1194 				    lda %%1
  1195 				    cmp %%2
  1196 				    bne _not
  1197 				        lda %%1+1
  1198 				        cmp %%2+1
  1199 				        bne _not
  1200 				            lda #NUtils.TRUE
  1201 				            jmp _exit
  1202 				_not
  1203 				    lda #NUtils.FALSE
  1204 				_exit
  1205 				.endm
  1206
