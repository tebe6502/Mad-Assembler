    20 				///	Set memory. Uses code auto-modification.
    21 				/**	@param .word %%1	Destination location.
    22 					@param .word %%2	Count.
    23 					@param .byte %%3	Value.
    24 				*/
    24
    25 				.macro	memset_macro
    26 					ldx	%%3
    27 					ldy	#0
    28 				loop
    29 					//	Test, whether we are done or not.
    30 					NUtils.tstzw	%%2
    31 					beq	done
    32 						txa
    33 						sta	(%%1),y
    34 					
    35 					NUtils.decw	%%2
    36 					iny
    37 					bne	loop
    38 					
    39 					inc	%%1+1
    40 					jmp	loop
    41 				done
    42 				.endm
    43
    44 				//******************************************************************************************************************************************************
    45
    46 				///	Copy data chunk from source into destination location.
    47 				/**	@param %%1 .word	- Zero-page destination location pointer.
    48 					@param %%2 .word	- Zero-page source location pointer.
    49 					@param %%3 .word	- Count.
    50 				*/
    50
    51 				.macro	memcpy_macro
    52 					NUtils.subw	%%2, %%1
    53 					bcs	forward
    54 				
    55 					.local	backward
    56 						NUtils.addw	%%2, %%3, %%2
    57 						NUtils.addw	%%1, %%3, %%1
    58 						NUtils.decw	%%2
    59 						NUtils.decw	%%1
    60 				
    61 						ldy	#0
    62 					loop:
    63 						//	Test, whether there are still any data to copy.
    64 						NUtils.tstzw	%%3
    65 						beq	done
    66 					
    67 						NUtils.movba	"(%%2),y", "(%%1),y"	//	Copy
    68 					
    69 						NUtils.decw	%%3
    70 						NUtils.decw	%%2
    71 						NUtils.decw	%%1
    72 						jmp	loop
    73 					.endl
    74 					
    75 					.local	forward
    76 						ldy	#0
    77 					loop:
    78 						//	Test, whether there are still any data to copy.
    79 						NUtils.tstzw	%%3
    80 						beq	done
    81 				
    82 						NUtils.movba	"(%%2),y", "(%%1),y"	//	Copy
    83 					
    84 						NUtils.decw	%%3
    85 						iny
    86 						bne	loop
    87 					
    88 						inc	%%2+1
    89 						inc	%%1+1
    90 						jmp	loop
    91 					.endl
    92 				
    93 				done
    94 				.endm
    95
    96 				//******************************************************************************************************************************************************
    97
    98 				.macro	memcpyp2	dst, src, count
    99 					ldy	%%count
   100 					dey
   101 				loop
   102 					lda	(%%src),y
   103 					sta	%%dst,y
   104 					dey
   105 					bpl	loop
   106 				.endm
   107
   108 				//******************************************************************************************************************************************************
   109
   110 				.macro	memcpyp3	dst, src, count
   111 					ldy	#(%%count-1)
   112 				loop
   113 					lda	(%%src),y
   114 					sta	%%dst,y
   115 					dey
   116 					bpl	loop
   117 				.endm
   118
   119 				//******************************************************************************************************************************************************
   120
   121 				///	Copy data chunk from source into destination location. Assumes no region overlapping.
   122 				/**	@param %%1 .word	- Destination location pointer.
   123 					@param %%2 .word	- Source location pointer.
   124 					@param %%3 .word	- Count.
   125 				*/
   125
   126 				.macro	memcpyno_macro
   127 					NUtils.tstzw	%%3
   128 					beq	skip
   129 				
   130 						NUtils.movw	%%2, full_pages_loop.src
   131 						NUtils.movw	%%1, full_pages_loop.dst
   132 						
   133 						ldx	%%3+1
   134 						beq	remains
   135 				
   136 							ldy	#0
   137 						
   138 							.local	full_pages_loop
   139 							loop:
   140 								src: = * + 1
   141 								lda	$ffff,y
   142 								dst: = * + 1
   143 								sta	$ffff,y
   144 								iny
   145 								bne	loop
   146 						
   147 								inc	src+1
   148 								inc	dst+1
   149 						
   150 								dex
   151 								bne	loop
   152 							.endl
   153 						
   154 					remains:
   155 						lda	%%3
   156 						beq	skip
   157 						
   158 							NUtils.movw	full_pages_loop.src, remains_loop.src
   159 							NUtils.movw	full_pages_loop.dst, remains_loop.dst
   160 						
   161 							.local	remains_loop
   162 							loop:
   163 								src = * + 1
   164 								lda	$ffff,y
   165 								dst = * + 1
   166 								sta	$ffff,y
   167 								iny
   168 								cpy	%%3
   169 								bne	loop
   170 							.endl
   171 					
   172 				skip
   173 				.endm
   174
   175 				//******************************************************************************************************************************************************
   176
   177 				///	Compares two tables for equality.
   178 				/**	@param .word %%1	First table pointer.
   179 					@param .word %%2	Second table pointer.
   180 					@param .word %%3	Table size.
   181 					@return A	- Flag indicating comparison status.
   182 						NUtils.TRUE		Equal.
   183 						NUtils.FALSE	Different.
   184 				*/
   184
   185 				.macro	strcmp_macro
   186 					ldy	#0
   187 					ldx	%%3+1
   188 					beq	last_page
   189 				
   190 					.local	full_pages
   191 					loop:
   192 						lda	(%%1),y
   193 						cmp	(%%2),y
   194 						bne	unequal
   195 						iny
   196 						bne	loop
   197 					
   198 						inc	%%1+1
   199 						inc	%%2+1
   200 						dex
   201 						bne	loop
   202 					.endl
   203 				
   204 					.local	last_page
   205 						lda	%%3
   206 						beq	equal
   207 					loop:
   208 						lda	(%%1),y
   209 						cmp	(%%2),y
   210 						bne	unequal
   211 						iny
   212 						cpy	%%3
   213 						bne	loop
   214 					.endl	
   215 					
   216 				equal
   217 					lda	#NUtils.TRUE
   218 					jmp	_exit
   219 					
   220 				unequal
   221 					lda	#NUtils.FALSE
   222 				_exit
   223 				.endm
   224
   225 				//******************************************************************************************************************************************************
   226
   227 				.endl // NMemory
   228
