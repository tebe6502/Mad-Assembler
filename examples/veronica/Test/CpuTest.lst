  1092 				*/
  1092
  1093 				.macro  negw
  1094 				    lda #0
  1095 				    sec
  1096 				    sbc %%1
  1097 				    sta %%1
  1098 				    
  1099 				    lda #0
  1100 				    sbc %%1+1
  1101 				    sta %%1+1
  1102 				.endm
