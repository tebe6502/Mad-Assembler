   314 					@param .byte count		Count.
   315 				*/
   315
   316 2113			.proc	memcpyhp(.word dst_ptr .word src_ptr .byte count) .var
   317 					count	= NMemory.count
   318 					
   319 					ldy	count
   320 					bne	continue
   321 					rts
