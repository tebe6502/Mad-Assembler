  1026 				//******************************************************************************************************************************************************
  1027
  1028 				/// Calculates absolute value.
  1029 				/** @param .word    Src or Dst.
  1030 				    @param .word    Dst (optional).
  1031 				*/
  1031
  1032 				.macro  absw
  1033 				    lda %%1+1
  1034 				    bpl skip
  1035 				        
  1036 				        lda #0
  1037 				        sec
  1038 				        sbc %%1
