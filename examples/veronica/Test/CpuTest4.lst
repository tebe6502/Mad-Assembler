   443
   444 				///	Restore memory locations.
   445 				/**	@param .word tbl_ptr	Backup table pointer.
   446 				*/
   446
   447 2113			.proc	restore(.word tbl_ptr) .var
   448 					tbl_ptr = NMemory.ptr
   449 					tmp_ptr = NMemory.ptr2
   450 					
   451 2113			loop
   452 					ldy	#0
   453 					NUtils.cmpba	"(tbl_ptr),y", #EType.NONE
   454 					bne	cont
   455 						//	Exit.
   456 						rts
   457 2113			cont
   458 					ldy	#1
   459 					NUtils.movba	"(tbl_ptr),y", tmp_ptr
   460 					iny
   461 					NUtils.movba	"(tbl_ptr),y", tmp_ptr+1
   462
   463 					//	Copy the first byte.
   464 					ldy	#3
   465 					lda	(tbl_ptr),y
   466 					ldy	#0
   467 					sta	(tmp_ptr),y
   468 					
   469 					//	if	(tbl_ptr[0] == EType.BYTE)
   470 					//ldy	#0
   471 					NUtils.cmpba	"(tbl_ptr),y", #EType.BYTE
   472 					bne	cont_2
   473 						NUtils.addbw	tbl_ptr, #4, tbl_ptr
   474 						jmp	loop
   475 					
   476 2113			cont_2
   477 					//	if	(tbl_ptr[0] == EType.WORD)
   478 					//ldy	#0
   479 					NUtils.cmpba	"(tbl_ptr),y", #EType.WORD
   480 					bne	cont_3
   481 						//	Copy second byte.
   482 						ldy	#4
   483 						lda	(tbl_ptr),y
   484 						ldy	#1
   485 						sta	(tmp_ptr),y
   486 						
   487 						NUtils.addbw	tbl_ptr, #5, tbl_ptr
   488 						jmp	loop
   489 					
   490 2113			cont_3
   491 					jmp	loop
   492 				.endp
