   359 				//******************************************************************************************************************************************************
   360
   361 				///	Copy data chunk from source into destination location.
   362 				/**	@param .word dst_ptr	Destination location pointer.
   363 					@param .word dst_modulo	Destination modulo.
   364 					@param .word src_ptr	Source location pointer.
   365 					@param .byte width		Width.
   366 					@param .byte height		Height.
   367 					@param .word src_modulo	Source modulo.
   368 				*/
   368
   369 2113			.proc	memcpym(.word dst_ptr .word dst_modulo .word src_ptr .byte width .byte height .word src_modulo) .var
   370 					dst_ptr = NMemory.ptr
   371 2113				.var	.word	dst_modulo
   372 					src_ptr = NMemory.ptr2
   373 2113				.var	.word	src_modulo
   374 					
   375 2113			loop_y
   376 					ldy	#0
   377 2113			loop_x
   378 					NUtils.movba	"(src_ptr),y", "(dst_ptr),y"
   379 					iny
   380 					cpy	width
   381 					bne	loop_x
   382 					
   383 					NUtils.addw	src_ptr, src_modulo, src_ptr
   384 					NUtils.addw	dst_ptr, dst_modulo, dst_ptr
   385
   386 					dec	height
   387 					bne	loop_y
   388 					rts
   389 				.endp
