     4 					icl	'API\protocol.h8'
     1 				//******************************************************************************************************************************************************
     2 				//	Header
     3 				//******************************************************************************************************************************************************
     4
     5 				/**	@file Protocol.h8
     6 					@author Marek "Konop" Konopka
     7 					@date 29.05.2010
     8 				*/
     8
     9
    10 				.local	NVeronica.NProtocol
    11
    12 				//******************************************************************************************************************************************************
    13 				//	Constants
    14 				//******************************************************************************************************************************************************
    15
    16 					///	Size of an array uniquely identifying Veronica's presence.
    17 = 0010				VERONICA_UUID_SIZE	= 16
    18
    19 					///	Must be big enought to allow finishing execution of IDENTIFY command on Veronica.
    20 = 00FF				IDENTIFY_CMD_TIMEOUT	= 255
    21
    22 				//******************************************************************************************************************************************************
    23 				//	Pointers
    24 				//******************************************************************************************************************************************************
    25
    26 					///	Location for the communication buffer in Veronica's address space.
    27 = C000				Initial_Window_Location	= $C000 // TODO: Rename to StartupWindowLocation
    28 = 4000				Final_Window_Location	= $4000 // TODO: Rename into RegularWindowLocation
    29
    30 					///	Location for the communication buffer in Atari address space.
    31 = 8000				Atari_Window_Location	= $8000
    32
    33 					///	Location for Veronica's hardware register.
    34 = 0200				Veronica_HW_Register	= $0200
    35
    36 					///	Location for Atari's register.
    37 = D5C0				Atari_HW_Register	= $d5c0
    38
    39 					///	Free RAM starting address of the window in Veronica's address space.
    40 = 4000				Veronica_Window_Ramlo	= Final_Window_Location
    41
    42 					///	Free RAM starting address of "the window" in Atari's address space.
    43 = 8000				Atari_Window_Ramlo	= Atari_Window_Location
    44
    45 				//******************************************************************************************************************************************************
    46 				//	Enumerations
    47 				//******************************************************************************************************************************************************
    48
    49 				///	Enumeration of Atari hardware register bits.
    50 				.enum	EAtariRegisterBits
    51 = 0007				SEMAPHORE_READ	= 7
    52 = 0007				SEMAPHORE_WRITE	= 7
    53 					
    54 = 0005				BANK1_ENABLE	= 5	// $A000-$BFFF -> $E000-$FFFF or $6000-$7FFF
    55 = 0004				BANK0_ENABLE	= 4	// $8000-$9FFF -> $C000-$DFFF or $4000-$5FFF
    56 				    
    57 = 0003			    SUBBANK_NUMBER = 3
    58 					
    59 = 0001				RAMBANK_CFG	= 1
    60 					
    61 = 0000				VERONICA_CPU_RESET	= 0
    62 				.ende
    63
    64 				//******************************************************************************************************************************************************
    65
    66 				///	Enumeration of Veronica hardware register bits.
    67 				.enum	EVeronicaRegisterBits
    68 = 0007			    SEMAPHORE_READ	= 7
    69 = 0007			    SEMAPHORE_WRITE	= 7
    70
    71 = 0006			    WINDOW_LOCATION	= 6
    72 				    
    73 = 0005			    SUBBANK_NUMBER = 5
    74 				.ende
    75
    76 				//******************************************************************************************************************************************************
    77
    78 				///	Enumeration of Atari hardware register bit combinations.
    79 				.enum	EAtariRegisterStates
    80 = 0080				UNLOCK_ATARI		= (1 << EAtariRegisterBits.SEMAPHORE_WRITE)
    81 = 0000				LOCK_ATARI			= (0 << EAtariRegisterBits.SEMAPHORE_WRITE)
    82 = 0080				VERONICA_UNLOCKED	= (1 << EAtariRegisterBits.SEMAPHORE_READ)
    83 = 0080				SEMAPHORE_MASK		= (1 << EAtariRegisterBits.SEMAPHORE_READ)
    84 					
    85 = 0010				BANK0_ENABLED	= (1 << EAtariRegisterBits.BANK0_ENABLE)
    86 = 0000				BANK0_DISABLED	= (0 << EAtariRegisterBits.BANK0_ENABLE)
    87 = 0020				BANK1_ENABLED	= (1 << EAtariRegisterBits.BANK1_ENABLE)
    88 = 0000				BANK1_DISABLED	= (0 << EAtariRegisterBits.BANK1_ENABLE)
    89 = 0030				BANKS_ENABLED	= (BANK0_ENABLED | BANK1_ENABLED)
    90 = 0000				BANKS_DISABLED	= 0
    91
    92 = 0010				BANK0_MASK	= (1 << EAtariRegisterBits.BANK0_ENABLE)
    93 = 0020				BANK1_MASK	= (1 << EAtariRegisterBits.BANK1_ENABLE)
    94 = 0030				BANKS_MASK	= (BANK0_MASK | BANK1_MASK)
    95 					
    96 = 0002				RAMBANK_CFG_MASK	= (1 << EAtariRegisterBits.RAMBANK_CFG)
    97
    98 = 0000				VER_CPU_RESET_PULSE_LOW		= (0 << EAtariRegisterBits.VERONICA_CPU_RESET)
    99 = 0001				VER_CPU_RESET_PULSE_HIGH	= (1 << EAtariRegisterBits.VERONICA_CPU_RESET)
   100 = 0001				VER_CPU_RESET_MASK	= (1 << EAtariRegisterBits.VERONICA_CPU_RESET)
   101 				.ende
   102
   103 				//******************************************************************************************************************************************************
   104
   105 				///	Enumeration of Veronica hardware register bit combinations.
   106 				.enum	EVeronicaRegisterStates
   107 = 0080				UNLOCK_VERONICA	= (1 << EVeronicaRegisterBits.SEMAPHORE_WRITE)
   108 = 0000				LOCK_VERONICA	= (0 << EVeronicaRegisterBits.SEMAPHORE_WRITE)
   109 = 0080				ATARI_UNLOCKED	= (1 << EVeronicaRegisterBits.SEMAPHORE_READ)
   110 = 0080				SEMAPHORE_MASK	= (1 << EVeronicaRegisterBits.SEMAPHORE_WRITE)
   111
   112 = 0000				WINDOW_LOCATION_C000	= (0 << EVeronicaRegisterBits.WINDOW_LOCATION)
   113 = 0040				WINDOW_LOCATION_4000	= (1 << EVeronicaRegisterBits.WINDOW_LOCATION)
   114 = 0040				WINDOW_LOCATION_MASK	= (1 << EVeronicaRegisterBits.WINDOW_LOCATION)
   115 				.ende
   116
   117 				//******************************************************************************************************************************************************
   118
   119 				///	List of commands to execute by Veronica.
   120 				.enum	ECommand
   121 					IDLE, IDENTIFY, DATA_CHUNK_UPLOAD, PROCEDURE_CALL, DATA_CHUNK_DOWNLOAD
   121 = 0000			IDLE
   121 = 0001			IDENTIFY
   121 = 0002			DATA_CHUNK_UPLOAD
   121 = 0003			PROCEDURE_CALL
   121 = 0004			DATA_CHUNK_DOWNLOAD
   122 				.ende
   123
   124 				//******************************************************************************************************************************************************
   125 				//	Structures
   126 				//******************************************************************************************************************************************************
   127
   128 				///	Base structure describing common data for all commands.
   129 				.struct	SCmdBase
   130 = 0000				m_command	.byte	/// Command to be passed to and executed on the Veronica.
   131 				.ends
   132
   133 				//******************************************************************************************************************************************************
   134
   135 				///	Describes idle command.
   136 				.struct	SIdleCmd
   137 					m_base	SCmdBase
   138 				.ends
   139
   140 				//******************************************************************************************************************************************************
   141
   142 				///	Describes Veronica presence identifier.
   143 				.struct	SIdentifyCmd
   144 					m_base	SCmdBase
   145 = 0001				m_uuid	:VERONICA_UUID_SIZE	.byte
   146 				.ends
   147
   148 				//******************************************************************************************************************************************************
   149
   150 				///	Describes data upload command.
   151 				.struct	SDataChunkUploadCmd
   152 					m_base	SCmdBase
   153 = 0001				m_chunk_dst_adr		.word
   154 = 0003				m_chunk_dst_size	.word
   155 				.ends
   156
   157 				//******************************************************************************************************************************************************
   158
   159 				///	Describes procedure execution command.
   160 				.struct	SProcedureCallCmd
   161 					m_base	SCmdBase
   162 = 0001				m_proc_adr	.word
   163 				.ends
   164
   165 				//******************************************************************************************************************************************************
   166
   167 				///	Describes data download command.
   168 				.struct	SDataChunkDownloadCmd
   169 					m_base	SCmdBase
   170 = 0001				m_chunk_src_adr		.word
   171 = 0003				m_chunk_src_size	.word
   172 				.ends
   173
   174 				//******************************************************************************************************************************************************
   175 				//	Macros
   176 				//******************************************************************************************************************************************************
   177
   178 				///	Wait for bit flip.
   179 				/**	@param %%1 .byte_ptr	- Memory location to test.
   180 					@param %%2 .byte 		- Constant representing bit number.
   181 					@param %%3 .byte		- Constant to test against.
   182 				*/
   182
   183 				.macro	wait_for_bit_flip
   184 				loop
   185 					lda	%%1
   186 					and	#(1 << (%%2))
   187 					.if ((%%3) != 0)
   188 						beq	loop
   189 					.else
   190 						bne	loop
   191 					.endif
   192 				.endm
   193
   194 				//******************************************************************************************************************************************************
   195
   196 				///	Wait for bit flip to occur within timeout restriction.
   197 				///	Must take long enough for Veronica to respond to the IDENTIFY command.
   198 				/**	@param .byte %%1	- Memory location to test.
   199 					@param .byte %%2	- Constant representing bit number.
   200 					@param .byte %%3	- Value to test against.
   201 					@param .macro %%4	- Timeout macro.
   202 					@param .byte X		- Maximal number of tests to perform.
   203 					
   204 					@return	.byte A	- Status flag indicating whether the test succeeded or not.
   205 				*/
   205
   206 				.macro	wait_for_bit_flip_with_timeout
   207 					loop:
   208 						lda	%%1
   209 						and	#(1 << (%%2))
   210 						.if ((%%3) != 0)
   211 							bne	matched
   212 						.else
   213 							beq	matched
   214 						.endif
   215 					
   216 						%%4
   217 						
   218 						dex
   219 						bne	loop
   220 				
   221 						//	Timeout elapsed.
   222 						lda	#NUtils.FALSE
   223 						jmp	done
   224 					
   225 					matched:
   226 						lda	#NUtils.TRUE
   227 					done:
   228 				.endm
   229
   230 				//******************************************************************************************************************************************************
   231
   232 				.macro	timeout_macro
   233 					//	at least 1282 cycles
   234 					ldy	#0
   235 				loop
   236 					iny
   237 					bne	loop
   238 				.endm
   239
   240 				//******************************************************************************************************************************************************
   241
   242 				///	Set bit under provided memory location.
   243 				/**	@param %%1 .byte_ptr	- Memory location.
   244 					@param %%2 .byte		- Constant representing bit number.
   245 					@param %%3 .byte		- Bit value (bit_value != 0).
   246 					write_bit
   247 				*/
   247
   248 				.macro	set_mem_bit
   249 					lda	%%1
   250 					.if	((%%3) == 0)
   251 						and	#~(1 << (%%2))
   252 					.else
   253 						ora	#(1 << (%%2))
   254 					.endif
   255 					sta	%%1
   256 				.endm
   257
   258 				//******************************************************************************************************************************************************
   259
   260 				///	Enable/disable specific bit under provided memory location.
   261 				/**	@param %%1 .byte_ptr	- Memory location.
   262 					@param %%2 .byte		- Constant representing bit mask.
   263 					@param %%3 .byte		- Or mask.
   264 				*/
   264
   265 				.macro	set_mem_bits
   266 					lda	%%1
   267 					and	#~(%%2)
   268 					ora	%%3
   269 					sta	%%1
   270 				.endm
   271
   272 				//******************************************************************************************************************************************************
   273
   274 				///	Sets or switches memory location bits.
   275 				/**	@param %%1 .byte	- Memory location to set.
   276 					@param %%2 .byte	- Bit mask constant for setting.
   277 					@param %%3 .byte	- Constant bit value for setting.
   278 					@param %%4 .byte	- Bit mask constant for switching.
   279 				*/
   279
   280 				.macro	set_or_switch_bits
   281 					lda	%%1
   282 					and	#~(%%2)
   283 					.if	((%%3) != 0)
   284 						ora	#(%%3)
   285 					.endif
   286 					.if	((%%4) != 0)
   287 						eor	#(%%4)
   288 					.endif
   289 					sta	%%1
   290 				.endm
   291
   292 				//******************************************************************************************************************************************************
   293
   294 				///	Clear memory location bits.
   295 				/**	@param %%1 .byte    Memory location to clear bits in.
   296 					@param %%2 .byte    Bit mask constant for clearing.
   297 				*/
   297
   298 				.macro  clear_bits
   299 				    lda %%1
   300 				    and #~(%%2)
   301 				    sta %%1
   302 				.endm
   303
   304 				//******************************************************************************************************************************************************
   305
   306 				///	Sets or switches memory location bits.
   307 				/**	@param %%1 .byte	- Memory location to set.
   308 					@param %%2 .byte	- Bit mask constant for setting.
   309 					@param %%3 .byte	- Bit mask constant for switching.
   310 					@param %%4 .byte	- Temporary helper variable containing bit values.
   311 				*/
   311
   312 				.macro	set_or_switch_mem_bits
   313 					lda	%%4
   314 					and	#(%%2)
   315 					sta	%%4
   316 				
   317 					lda	%%1
   318 					and	#~(%%2)
   319 					.if	((%%3) != 0)
   320 						eor	#(%%3)
   321 					.endif
   322 					ora	%%4
   323 					sta	%%1
   324 				.endm
   325
   326 				//******************************************************************************************************************************************************
   327
   328 				///	Wait for Atari to finish its task.
   329 				.macro	wait_for_atari
   330 				loop
   331 					//	We can utilize negative flag flipping here since EVeronicaRegisterBits.SEMAPHORE_READ is D7.
   332 					lda	Veronica_HW_Register
   333 					bpl	loop
   334 				.endm
   335
   336 				//******************************************************************************************************************************************************
   337
   338 				///	Wait for Veronica to finish its task.
   339 				.macro	wait_for_veronica
   340 				loop
   341 					//	We can utilize negative flag here since EAtariRegisterBits.SEMAPHORE_READ is B7.
   342 					lda	Atari_HW_Register
   343 					bpl	loop
   344 				.endm
   345
   346 				//******************************************************************************************************************************************************
   347
   348 				///	Wait for Veronica to finish its task within timeout restriction.
   349 				/**	@param .byte X	- Timeout.
   350 				*/
   350
   351 				.macro	wait_for_veronica_with_timeout
   352 					wait_for_bit_flip_with_timeout	Atari_HW_Register, EAtariRegisterBits.SEMAPHORE_READ, EAtariRegisterStates.VERONICA_UNLOCKED, timeout_macro
   353 				.endm
   354
   355 				//******************************************************************************************************************************************************
   356
   357 				///	Disable Atari occupation status. Modify single specific bit only. Leave the rest of them unchanged.
   358 				.macro	unlock_atari
   359 					set_mem_bit	Atari_HW_Register, EAtariRegisterBits.SEMAPHORE_WRITE, EAtariRegisterStates.UNLOCK_ATARI
   360 				.endm
   361
   362 				//******************************************************************************************************************************************************
   363
   364 				///	Disable Veronica occupation status. Modify single specific bit only. Leave the rest of them unchanged.
   365 				.macro	unlock_veronica
   366 				    .using NVeronica.NProtocol
   367 				    
   368 					set_mem_bit	Veronica_HW_Register, EVeronicaRegisterBits.SEMAPHORE_WRITE, EVeronicaRegisterStates.UNLOCK_VERONICA
   369 					//set_mem_bits	Veronica_HW_Register, (EVeronicaRegisterStates.SEMAPHORE_MASK | EVeronicaRegisterStates.WINDOW_LOCATION_MASK), #(EVeronicaRegisterStates.UNLOCK_VERONICA | EVeronicaRegisterStates.WINDOW_LOCATION_4000)
   370 				.endm
   371
   372 				//******************************************************************************************************************************************************
   373
   374 				///	Disable Atari occupation status and swap window banks under cartridge memory location.
   375 				.macro	unlock_and_swap
   376 					set_or_switch_bits	Atari_HW_Register, EAtariRegisterStates.SEMAPHORE_MASK, EAtariRegisterStates.UNLOCK_ATARI, EAtariRegisterStates.RAMBANK_CFG_MASK
   377 				.endm
   378
   379 				//******************************************************************************************************************************************************
   380
   381 				///	Swap rambanks.
   382 				.macro	swap_banks
   383 					NUtils.eorba	Atari_HW_Register, #(EAtariRegisterStates.UNLOCK_ATARI | EAtariRegisterStates.RAMBANK_CFG_MASK), Atari_HW_Register
   384 				.endm
   385
   386 				//******************************************************************************************************************************************************
   387
   388 				///	Wait for Veronica, unlock Atari and swap banks.
   389 				.macro	wait_swap_unlock
   390 				loop
   391 					lda	Atari_HW_Register
   392 					bpl	loop
   393 					
   394 					eor	#EAtariRegisterStates.RAMBANK_CFG_MASK
   395 					sta	Atari_HW_Register
   396 				.endm
   397
   398 				//******************************************************************************************************************************************************
   399
   400 				.macro	reset_wait
   401 					ldx	#0
   402 				loop
   403 					.rept	18
   404 						nop
   405 					.endr
   406 				
   407 					dex
   408 					bne	loop
   409 				.endm
