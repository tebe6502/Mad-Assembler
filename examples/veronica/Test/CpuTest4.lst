   342 				*/
   342
   343 2113			.proc	memcpyp(.word dst_ptr .word src_ptr .byte count) .var
   344 					count	= NMemory.count
   345
   346 					ldy	#0	
   347 2113			loop
   348 					src_ptr = * + 1
   349 						lda $ffff,y	// auto-modification
   350 					dst_ptr = * + 1
   351 						sta $ffff,y	// auto-modification
   352 					
   353 					iny
   354 					cpy	count
   355 					bne	loop
   356 					rts
