    10
    11 				//******************************************************************************************************************************************************
    12 				//	Code
    13 				//******************************************************************************************************************************************************
    14
    15 				///	Compares two tables for equality.
    16 				/**	@param .word tbl0_ptr	First table pointer.
    17 					@param .word tbl1_ptr	Second table pointer.
    18 					@param .byte size		Table size. Must be greater than zero.
    19 					@return A	- Flag indicating comparison status.
    20 						NUtils.TRUE		Equal.
    21 						NUtils.FALSE	Different.
    22 				*/
    22
    23 208A			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 					tbl0_ptr = NMemory.ptr
    25 					tbl1_ptr = NMemory.ptr2
    26 					count = NMemory.count
    27
    28 					ldy	#0
    29 					ldx	count+1
    30 					beq	last_page
    31
    32 208A				.local	full_pages
    33 208A				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 208A				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 208A				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 208A			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 208A			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Compares two half-page sized tables for equality. Uses code auto-modification.
    70 				/**	@param .word tbl0_ptr	First table pointer.
    71 					@param .word tbl1_ptr	Second table pointer.
    72 					@param .byte size		Table size.
    73 					@return A	- Flag indicating comparison status.
    74 						NUtils.TRUE		Equal.
    75 						NUtils.FALSE	Different.
    76 				*/
    76
    77 208A			.proc	strcmphp(.word tbl0_ptr .word tbl1_ptr .byte size) .var
    78 					size = * + 1
    79 						ldy	#$ff
    80 					dey
    81 208A			loop
    82 					tbl0_ptr = *+1
    83 						lda	$ffff,y
    84 					tbl1_ptr = *+1
    85 						cmp	$ffff,y
    86 					bne	inequality
    87 					
    88 					dey
    89 					bpl	loop
    90 					
    91 					//	equality
    92 					lda	#NUtils.TRUE
    93 					rts
    94
    95 208A			inequality
    96 					lda	#NUtils.FALSE
    97 					rts
    98 				.endp
    99
   100 				//******************************************************************************************************************************************************
   101
   102 				///	Set memory. Uses code auto-modification.
   103 				/**	@param .word %%1	Destination location.
   104 					@param .word %%2	Count.
   105 					@param .byte %%3	Value.
   106 				*/
   106
   107 208A			.proc	memset(.word dst_ptr .word count .byte value) .var
   108 					dst_ptr	= NMemory.ptr
   109 					count	= NMemory.count
   110 					value	= NMemory.value
   111 					
   112 					ldx	value
   113 					ldy	#0
   114 208A			loop
   115 					//	Test, whether we are done or not.
   116 					NUtils.tstzw	count
   117 					beq	done
   118 						txa
   119 						sta	(dst_ptr),y
   120 					
   121 					NUtils.decw	count
   122 					iny
   123 					bne	loop
   124 					
   125 					inc	dst_ptr+1
   126 					jmp	loop
   127 208A			done
   128 					rts
   129 				.endp
   130
   131 				//******************************************************************************************************************************************************
   132
   133 				///	Set memory. Range restricted to one page only. Uses code auto-modification.
   134 				/**	@param .word dst_ptr	Destination pointer. Should be page aligned to achieve best performance.
   135 					@param .byte count	Count.
   136 					@param .byte value	Value.
   137 				*/
   137
   138 208A			.proc	memsetp(.word dst_ptr .byte count .byte value) .var
   139 					value = * + 1
   140 						lda	#0
   141 					count = * + 1	// auto-modification
   142 						ldy	#0
   143 208A			loop
   144 					dey
   145 					dst_ptr	= * + 1
   146 						sta	$ffff,y	// auto-modification
   147 					bne	loop
   148 					rts
   149 				.endp
   150
   151 				//******************************************************************************************************************************************************
   152
   153 				///	Set 2D table. Uses code auto-modification.
   154 				/**	@param .word %%1	- Destination location.
   155 					@param .byte %%2	- Width.
   156 					@param .word %%3	- Modulo.
   157 					@param .byte %%4	- Height.
   158 					@param .byte %%5	- Value.
   159 				*/
   159
   160 208A			.proc	memsetm(.word dst_ptr .byte width .word modulo .byte height .byte value) .var
   161 					dst_ptr = NMemory.ptr
   162 					width = NMemory.width
   163 					modulo = NMemory.modulo
   164 					height = NMemory.height
   165 					value	= NMemory.value
   166
   167 					ldx	height
   168 208A			loop2
   169 					ldy	#0
   170 					lda	value
   171 208A			loop
   172 					sta	(dst_ptr),y
   173 					iny
   174 					cpy	width
   175 					bne	loop
   176 					
   177 					NUtils.addw	dst_ptr, modulo, dst_ptr
   178 					dex
   179 					bne	loop2
   180 					rts
   181 				.endp
   182
   183 				//******************************************************************************************************************************************************
   184
   185 				/**	(byte*)	tmp_vct0	- destination
   186 					.word tmp_vct1		- count
   187 					.byte tmp_vct2		- value
   188 				*/
   188
