  1045 				        lda #0
  1046 				        sbc %%1+1
  1047 				        .if %%0 == 1
  1048 				            sta %%1+1
  1049 				        .else
  1050 				            sta %%2+1
  1051 				        .endif
  1052 				        
  1053 				        .if %%0 == 2
  1054 				            jmp _exit
  1055 				        .endif
  1056 				skip
  1057 				    .if %%0 == 2
  1058 				        sta %%2+1
  1059 				        lda %%1
  1060 				        sta %%2
  1061 				    _exit:
  1062 				    .endif
  1063 				.endm
  1064
  1065 				//******************************************************************************************************************************************************
  1066
  1067 				/// Negates accumulator.
  1068 				/** @param .byte A  Par.
  1069 				*/
  1069
  1070 				.macro  nega
  1071 				    eor #$ff
  1072 				    clc
  1073 				    adc #1
  1074 				.endm
