   268 2113			.proc	fwdmemcpy(.word dst_ptr .word src_ptr .word count) .var
   269 					dst_ptr = NMemory.ptr
   270 					src_ptr = NMemory.ptr2
   271 					count = NMemory.count
   272
   273 					ldy	#0
   274
   275 					ldx	count+1
   276 					beq	copy_last_page
   277 						
   278 						sty	copy.count
   279 						
   280 2113					.local	copy_pages
   281 							jsr	copy
   282 							inc	src_ptr+1
   283 							inc	dst_ptr+1
   284 							dex
   285 							bne	copy_pages
   286 						.endl
