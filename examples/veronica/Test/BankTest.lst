    15 				///	Compares two tables for equality.
    16 				/**	@param .word tbl0_ptr	First table pointer.
    17 					@param .word tbl1_ptr	Second table pointer.
    18 					@param .byte size		Table size. Must be greater than zero.
    19 					@return A	- Flag indicating comparison status.
    20 						NUtils.TRUE		Equal.
    21 						NUtils.FALSE	Different.
    22 				*/
    22
    23 6683			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 = 0086				tbl0_ptr = NMemory.ptr
    25 = 0088				tbl1_ptr = NMemory.ptr2
    26 = 675E				count = NMemory.count
    27
    28 6683 A0 00			ldy	#0
    29 6685 AE 5F 67			ldx	count+1
    30 6688 F0 10			beq	last_page
    31
    32 668A				.local	full_pages
    33 668A				loop:
    34 668A B1 86				lda	(tbl0_ptr),y
    35 668C D1 88				cmp	(tbl1_ptr),y
    36 668E D0 1E				bne	unequal
    37 6690 C8					iny
    38 6691 D0 F7				bne	loop
    39 					
    40 6693 E6 87				inc	tbl0_ptr+1
    41 6695 E6 89				inc	tbl1_ptr+1
    42 6697 CA					dex
    43 6698 D0 F0				bne	loop
    44 					.endl
    45
    46 669A				.local	last_page
    47 669A AD 5E 67				lda	count
    48 669D F0 0C				beq	equal
    49 669F				loop:
    50 669F B1 86				lda	(tbl0_ptr),y
    51 66A1 D1 88				cmp	(tbl1_ptr),y
    52 66A3 D0 09				bne	unequal
    53 66A5 C8					iny
    54 66A6 CC 5E 67				cpy	count
    55 66A9 D0 F4				bne	loop
    56 					.endl	
    57 					
    58 66AB			equal
    59 66AB A9 01			lda	#NUtils.TRUE
    60 66AD 60				rts
    61 					
    62 66AE			unequal
    63 66AE A9 00			lda	#NUtils.FALSE
    64 66B0 60				rts
    65 				.endp
