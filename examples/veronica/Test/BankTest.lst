    28 				///	Enable rambanks.
    29 				/**	@param .byte rambank_bits	- Rambank bit combination.
    30 				*/
    30
    31 6866			.proc	set_rambanks(.byte rambank_bits) .var
    32 6866				.var .byte	rambank_bits
    33 					
    34 6866				.using	NVeronica.NProtocol.EAtariRegisterStates
    35 					
    36 				    // TODO: Should not set b7 in $d500!!! Leave it unchanged.
    37 6866				NVeronica.NProtocol.set_or_switch_mem_bits	NVeronica.NProtocol.Atari_HW_Register, BANKS_MASK, SEMAPHORE_MASK, rambank_bits
Macro: NVeronica.NProtocol.set_or_switch_mem_bits [Source: Protocol.h8]
     1 6866 AD 7C 68			lda	rambank_bits
     2 6869 29 30			and	#(BANKS_MASK)
     3 686B 8D 7C 68			sta	rambank_bits
     5 686E AD C0 D5			lda	NVeronica.NProtocol.Atari_HW_Register
     6 6871 29 CF			and	#~(BANKS_MASK)
     8 6873 49 80				eor	#(SEMAPHORE_MASK)
    10 6875 0D 7C 68			ora	rambank_bits
    11 6878 8D C0 D5			sta	NVeronica.NProtocol.Atari_HW_Register
Source: Master.as8
    38 687B 60				rts
    39 = 687C 00		rambank_bits
    39 				.endp
