    41 				//******************************************************************************************************************************************************
    42
    43 				///	Boot Veronica.
    44 				/**	@param .word_ptr boot_src_ptr	- Bootstrap source location.
    45 					@param .word_ptr boot_dst_ptr	- Bootstrap destination location (window).
    46 					@param .word_ptr boot_size		- Bootstrap size.
    47 					@param .word_ptr bios_src_ptr		- Bios source location.
    48 					@param .word_ptr bios_dst_ptr		- Bios destination location (window).
    49 					@param .word_ptr bios_size			- Bios size.	
    50 				*/
    50
    51 687D			.proc	boot_veronica(.word boot_src_ptr .word boot_dst_ptr .word boot_size .word bios_src_ptr .word bios_dst_ptr .word bios_size .word startup_ptr) .var
    52 687D				.var	.word boot_src_ptr, boot_dst_ptr, boot_size, bios_src_ptr, bios_dst_ptr, bios_size//, startup_ptr
    53 					startup_ptr = NVeronica.NProtocol.Atari_Window_Location+(NCpu.CPURES-NVeronica.NProtocol.Initial_Window_Location)
    54 					
    55 					//	Copy bootstrap
    56 					NMemory.memcpy	boot_dst_ptr, boot_src_ptr, boot_size
    57 					
    58 					//	Copy BIOS
    59 					NMemory.memcpy	bios_dst_ptr, bios_src_ptr, bios_size
    60
    61 					/*swap_banks
    62 					reset_veronica*/
    62
    63 					swap_and_reset
    64 					rts
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Identify Veronica's presence.
    70 				/**	@param .byte timeout	- Timeout.
    71 					@return	.byte A	- Status flag indicating Veronica's presence.
    72 				*/
    72
    73 687D			.proc	identify(.byte timeout) .var
    74 687D				.var .byte	timeout
    75
    76 					//	Clear rambank memory to make sure Veronica overwrites it.
    77 					NUtils.movba	#NVeronica.NProtocol.ECommand.IDLE, NVeronica.NProtocol.Atari_Window_Ramlo
    78 					
    79 					setup_identify_cmd
    80 					execute_command_with_timeout	timeout
    81 					cmp	#NUtils.TRUE
    82 					beq	cont
    83 						//	Timeout. Veronica absent or timed out.
    84 						//lda	#NUtils.FALSE
    85 						rts
    86 					
    87 				//------------------------------------------------------------------------------------------------------------------------------------------------------
    88
    89 687D			cont
    90 					//	Wait for Veronica until she finishes executing the IDENTIFY command or timeouts.
    91 					wait_for_veronica_with_timeout	#NVeronica.NProtocol.IDENTIFY_CMD_TIMEOUT
    92 					cmp	#NUtils.TRUE
    93 					beq	cont_2
    94 						//	Veronica absent or timed out.
    95 						//lda	#NUtils.FALSE
    96 						rts
    97
    98 				//------------------------------------------------------------------------------------------------------------------------------------------------------
    99
   100 687D			cont_2
   101 					swap_banks
   102 					NMemory.strcmphp	#(NVeronica.NProtocol.Atari_Window_Ramlo+NVeronica.NProtocol.SIdentifyCmd.m_uuid), #uuid_template_tbl, #NVeronica.NProtocol.VERONICA_UUID_SIZE
   103 					//	NMemory.strcmphp returns the appropriate exit status.
   104 					rts
   105 				.endp
   106
   107 				//******************************************************************************************************************************************************
   108
   109 				///	Execute command.
   110 				/**
   111 				*/
   111
   112 687D			.proc	execute_command
   113 					wait_for_veronica
   114 					unlock_and_swap
   115 					rts
   116 				.endp
   117
   118 				//******************************************************************************************************************************************************
   119
   120 				///	Execute command. Use timeout limitation.
   121 				/**	@param .byte X	- Timeout
   122 					@return .byte A	- Status.
   123 				*/
   123
   124 687D			.proc	execute_command_with_timeout(.byte x) .reg
   125 					jsr	wait_for_veronica_with_timeout
   126 					cmp	#NUtils.TRUE
   127 					beq	cont
   128 						//lda	#NUtils.FALSE
   129 						rts
   130 687D			cont
   131 					unlock_and_swap
   132 					lda	#NUtils.TRUE
   133 					rts
   134 				.endp
   135
   136 				//******************************************************************************************************************************************************
   137
   138 				///	Setup Veronica identification command.
   139 687D			.proc	setup_identify_cmd
   140 					NUtils.movba	#NVeronica.NProtocol.ECommand.IDENTIFY, NVeronica.NProtocol.Atari_Window_Ramlo+NVeronica.NProtocol.SCmdBase.m_command
   141 					rts
   142 				.endp
