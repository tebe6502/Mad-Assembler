   211 				*/
   211
   212 687D			.proc	execute_procedure_call_cmd(.word proc_ptr) .var
   213 					proc_ptr = setup_procedure_call_cmd.proc_adr
   214
   215 					//setup_procedure_call_cmd	NVeronica.NProtocol.Atari_Window_Ramlo+NVeronica.NProtocol.SProcedureCallCmd.m_proc_adr
