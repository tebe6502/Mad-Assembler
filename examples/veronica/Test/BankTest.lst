    67 				//******************************************************************************************************************************************************
    68
    69 				///	Compares two half-page sized tables for equality. Uses code auto-modification.
    70 				/**	@param .word tbl0_ptr	First table pointer.
    71 					@param .word tbl1_ptr	Second table pointer.
    72 					@param .byte size		Table size.
    73 					@return A	- Flag indicating comparison status.
    74 						NUtils.TRUE		Equal.
    75 						NUtils.FALSE	Different.
    76 				*/
    76
    77 66B1			.proc	strcmphp(.word tbl0_ptr .word tbl1_ptr .byte size) .var
    78 					size = * + 1
    79 						ldy	#$ff
    80 					dey
    81 66B1			loop
    82 					tbl0_ptr = *+1
    83 						lda	$ffff,y
    84 					tbl1_ptr = *+1
    85 						cmp	$ffff,y
    86 					bne	inequality
    87 					
    88 					dey
    89 					bpl	loop
    90 					
    91 					//	equality
    92 					lda	#NUtils.TRUE
    93 					rts
    94
    95 66B1			inequality
    96 					lda	#NUtils.FALSE
    97 					rts
    98 				.endp
