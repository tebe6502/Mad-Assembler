   194 				//******************************************************************************************************************************************************
   195
   196 				///	Execute data upload command.
   197 				/**	@param .word src_adr	- Source location of a data chunk in Atari's address space.
   198 					@param .word size		- Size of data chunk to copy.
   199 					@param .word dst_adr	- Destination location of data chunk in Veronica's address space.
   200 				*/
   200
   201 687D			.proc	execute_data_upload_cmd(.word src_adr .word size .word dst_adr) .var
   202 					setup_data_upload_cmd	src_adr, size, dst_adr
   203 					execute_command
   204 					rts
   205 				.endp
