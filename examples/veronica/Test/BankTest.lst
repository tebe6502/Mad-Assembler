   133 					sta	ICBUFA+0,x
   134 					tya
   135 					sta	ICBUFA+1,x
   136
   137 					NUtils.movba	#MAX_STR_LEN, "ICBUFL,x"
   138 					NUtils.movba	#$05, "ICCMD,x"
   139 					
   140 					jmp	CIOV
   141 				.endp
