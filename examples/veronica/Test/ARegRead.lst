   336 				//******************************************************************************************************************************************************
   337
   338 				///	Copy data chunk from source into destination location. Range restricted to one page only. Uses code auto-modification.
   339 				/**	@param .word dst_ptr	Destination location pointer. Should be page aligned to achieve best performance.
   340 					@param .word src_ptr	Source location pointer. Should be page aligned to achieve best performance.
   341 					@param .byte count		Count (1-255).
   342 				*/
   342
   343 215C			.proc	memcpyp(.word dst_ptr .word src_ptr .byte count) .var
   344 					count	= NMemory.count
   345
   346 					ldy	#0	
   347 215C			loop
   348 					src_ptr = * + 1
   349 						lda $ffff,y	// auto-modification
   350 					dst_ptr = * + 1
   351 						sta $ffff,y	// auto-modification
   352 					
   353 					iny
   354 					cpy	count
   355 					bne	loop
   356 					rts
   357 				.endp
   358
   359 				//******************************************************************************************************************************************************
   360
   361 				///	Copy data chunk from source into destination location.
   362 				/**	@param .word dst_ptr	Destination location pointer.
   363 					@param .word dst_modulo	Destination modulo.
   364 					@param .word src_ptr	Source location pointer.
   365 					@param .byte width		Width.
   366 					@param .byte height		Height.
   367 					@param .word src_modulo	Source modulo.
   368 				*/
   368
   369 215C			.proc	memcpym(.word dst_ptr .word dst_modulo .word src_ptr .byte width .byte height .word src_modulo) .var
   370 					dst_ptr = NMemory.ptr
   371 215C				.var	.word	dst_modulo
   372 					src_ptr = NMemory.ptr2
   373 215C				.var	.word	src_modulo
   374 					
   375 215C			loop_y
   376 					ldy	#0
   377 215C			loop_x
   378 					NUtils.movba	"(src_ptr),y", "(dst_ptr),y"
   379 					iny
   380 					cpy	width
   381 					bne	loop_x
   382 					
   383 					NUtils.addw	src_ptr, src_modulo, src_ptr
   384 					NUtils.addw	dst_ptr, dst_modulo, dst_ptr
   385
   386 					dec	height
   387 					bne	loop_y
   388 					rts
   389 				.endp
