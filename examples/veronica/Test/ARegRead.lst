   246
   247 				///	Copy data chunk from source into destination location.
   248 				/**	@param .word dst_ptr	Destination location pointer.
   249 					@param .word src_ptr	Source location pointer.
   250 					@param .word count		Count.
   251 				*/
   251
   252 215C			.proc	memcpy(.word dst_ptr .word src_ptr .word count) .var
   253 					dst_ptr = NMemory.ptr
   254 					src_ptr = NMemory.ptr2
   255 					count = NMemory.count
   256
   257 					NMemory.memcpy_macro	NMemory.ptr, NMemory.ptr2, NMemory.count
   258 					rts
   259 				.endp
   260
   261 				//******************************************************************************************************************************************************
   262
   263 				///	Copy data chunk from source into destination location in forward direction.
   264 				/**	@param .word dst_ptr	Destination location pointer.
   265 					@param .word src_ptr	Source location pointer.
   266 					@param .word count		Count.
   267 				*/
   267
   268 215C			.proc	fwdmemcpy(.word dst_ptr .word src_ptr .word count) .var
   269 					dst_ptr = NMemory.ptr
   270 					src_ptr = NMemory.ptr2
   271 					count = NMemory.count
   272
   273 					ldy	#0
   274
   275 					ldx	count+1
   276 					beq	copy_last_page
   277 						
   278 						sty	copy.count
   279 						
   280 215C					.local	copy_pages
   281 							jsr	copy
   282 							inc	src_ptr+1
   283 							inc	dst_ptr+1
   284 							dex
   285 							bne	copy_pages
   286 						.endl
   287
   288 215C			copy_last_page
   289 					lda	count
   290 					beq	copy._exit
   291
   292 						sta	copy.count
   293
   294 215C					.proc	copy(.byte count) .var
   295 215C						.var	.byte	count
   296
   297 215C						.local	loop
   298 								lda	(src_ptr),y
   299 								sta	(dst_ptr),y
   300 								iny
   301 								cpy	count
   302 								bne	loop
   303 							.endl
   304 					
   305 215C					_exit:	rts
   306 						.endp
   307 				.endp
