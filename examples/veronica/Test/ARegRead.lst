   192 215C				icl	'memory.as8'
Source: memory.as8
     1 215C			.local	NMemory
     2
     3 				//******************************************************************************************************************************************************
     4 				//	Variables
     5 				//******************************************************************************************************************************************************
     6
     7 215C				.zpvar	.word	ptr, ptr2
     8 215C				.var	.word	count, modulo
     9 215C				.var	.byte	value, width, height
    10
    11 				//******************************************************************************************************************************************************
    12 				//	Code
    13 				//******************************************************************************************************************************************************
    14
    15 				///	Compares two tables for equality.
    16 				/**	@param .word tbl0_ptr	First table pointer.
    17 					@param .word tbl1_ptr	Second table pointer.
    18 					@param .byte size		Table size. Must be greater than zero.
    19 					@return A	- Flag indicating comparison status.
    20 						NUtils.TRUE		Equal.
    21 						NUtils.FALSE	Different.
    22 				*/
    22
    23 215C			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 					tbl0_ptr = NMemory.ptr
    25 					tbl1_ptr = NMemory.ptr2
    26 					count = NMemory.count
    27
    28 					ldy	#0
    29 					ldx	count+1
    30 					beq	last_page
    31
    32 215C				.local	full_pages
    33 215C				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 215C				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 215C				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 215C			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 215C			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Compares two half-page sized tables for equality. Uses code auto-modification.
    70 				/**	@param .word tbl0_ptr	First table pointer.
    71 					@param .word tbl1_ptr	Second table pointer.
    72 					@param .byte size		Table size.
    73 					@return A	- Flag indicating comparison status.
    74 						NUtils.TRUE		Equal.
    75 						NUtils.FALSE	Different.
    76 				*/
    76
    77 215C			.proc	strcmphp(.word tbl0_ptr .word tbl1_ptr .byte size) .var
    78 					size = * + 1
    79 						ldy	#$ff
    80 					dey
    81 215C			loop
    82 					tbl0_ptr = *+1
    83 						lda	$ffff,y
    84 					tbl1_ptr = *+1
    85 						cmp	$ffff,y
    86 					bne	inequality
    87 					
    88 					dey
    89 					bpl	loop
    90 					
    91 					//	equality
    92 					lda	#NUtils.TRUE
    93 					rts
    94
    95 215C			inequality
    96 					lda	#NUtils.FALSE
    97 					rts
    98 				.endp
    99
   100 				//******************************************************************************************************************************************************
   101
   102 				///	Set memory. Uses code auto-modification.
   103 				/**	@param .word %%1	Destination location.
   104 					@param .word %%2	Count.
   105 					@param .byte %%3	Value.
   106 				*/
   106
   107 215C			.proc	memset(.word dst_ptr .word count .byte value) .var
   108 					dst_ptr	= NMemory.ptr
   109 					count	= NMemory.count
   110 					value	= NMemory.value
   111 					
   112 					ldx	value
   113 					ldy	#0
   114 215C			loop
   115 					//	Test, whether we are done or not.
   116 					NUtils.tstzw	count
   117 					beq	done
   118 						txa
   119 						sta	(dst_ptr),y
   120 					
   121 					NUtils.decw	count
   122 					iny
   123 					bne	loop
   124 					
   125 					inc	dst_ptr+1
   126 					jmp	loop
   127 215C			done
   128 					rts
   129 				.endp
   130
   131 				//******************************************************************************************************************************************************
   132
   133 				///	Set memory. Range restricted to one page only. Uses code auto-modification.
   134 				/**	@param .word dst_ptr	Destination pointer. Should be page aligned to achieve best performance.
   135 					@param .byte count	Count.
   136 					@param .byte value	Value.
   137 				*/
   137
   138 215C			.proc	memsetp(.word dst_ptr .byte count .byte value) .var
   139 					value = * + 1
   140 						lda	#0
   141 					count = * + 1	// auto-modification
   142 						ldy	#0
   143 215C			loop
   144 					dey
   145 					dst_ptr	= * + 1
   146 						sta	$ffff,y	// auto-modification
   147 					bne	loop
   148 					rts
   149 				.endp
   150
   151 				//******************************************************************************************************************************************************
   152
   153 				///	Set 2D table. Uses code auto-modification.
   154 				/**	@param .word %%1	- Destination location.
   155 					@param .byte %%2	- Width.
   156 					@param .word %%3	- Modulo.
   157 					@param .byte %%4	- Height.
   158 					@param .byte %%5	- Value.
   159 				*/
   159
   160 215C			.proc	memsetm(.word dst_ptr .byte width .word modulo .byte height .byte value) .var
   161 					dst_ptr = NMemory.ptr
   162 					width = NMemory.width
   163 					modulo = NMemory.modulo
   164 					height = NMemory.height
   165 					value	= NMemory.value
   166
   167 					ldx	height
   168 215C			loop2
   169 					ldy	#0
   170 					lda	value
   171 215C			loop
   172 					sta	(dst_ptr),y
   173 					iny
   174 					cpy	width
   175 					bne	loop
   176 					
   177 					NUtils.addw	dst_ptr, modulo, dst_ptr
   178 					dex
   179 					bne	loop2
   180 					rts
   181 				.endp
   182
   183 				//******************************************************************************************************************************************************
   184
   185 				/**	(byte*)	tmp_vct0	- destination
   186 					.word tmp_vct1		- count
   187 					.byte tmp_vct2		- value
   188 				*/
   188
   189 				/*.proc	memsetf
   190 					NUM_BITS = 4
   191 					
   192 					.var .word	cnt16s
   193 					
   194 					NUtils.movw	tmp_vct1, cnt16s
   195 					NUtils.lsrw		cnt16s, NUM_BITS
   196 				loop_16s
   197 					NUtils.tstzw	cnt16s
   198 					beq				done_16s
   199
   200 					ldy	#0
   201 					lda	tmp_vct2
   202 					.rept	(1<<NUM_BITS)-1
   203 						sta	(tmp_vct0),y
   204 						iny
   205 					.endr
   206 					sta	(tmp_vct0),y
   207 					
   208 					NUtils.addbwa	tmp_vct0, #(1<<NUM_BITS)
   209 					NUtils.decw		cnt16s
   210 					jmp				loop_16s
   211
   212 				done_16s
   213 					.var .byte	rest, tmp
   214 					
   215 					NUtils.andb		tmp_vct1, #((1<<NUM_BITS)-1), rest
   216 					beq	done
   217 					
   218 				cont_rest
   219 					NUtils.subba	#((1<<NUM_BITS)-1), rest, tmp
   220 					asl	@
   221 					//clc
   222 					adc	tmp
   223 					adc	<rest_start
   224 					sta	jmp_adr+1
   225 					lda	>rest_start
   226 					adc #0
   227 					sta	jmp_adr+2
   228
   229 					lda	tmp_vct2
   230 					ldy	#0
   231 				jmp_adr
   232 					jmp	$ffff	// auto-modification
   233 						
   234 				rest_start
   235 					.rept	((1<<NUM_BITS)-2)
   236 						sta	(tmp_vct0),y
   237 						iny
   238 					.endr
   239 					sta	(tmp_vct0),y
   240
   241 				done
   242 					rts
   243 				.endp*/
