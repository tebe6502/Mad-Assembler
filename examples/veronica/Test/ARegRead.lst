   145 				///	Convert byte into lowercase, hexadecimal ATASCII string.
   146 				/**	@param .byte value	Value to convert.
   147 					@param .word dst_ptr	Pointer to destination buffer.
   148 				*/
   148
   149 2193			.proc	bta(.byte value .word ptr) .var
   150 					value	= NConsole.value
   151 					ptr 	= NConsole.ptr
   152
   153 					lda	value
   154 					NUtils.lsra	4
   155 					tax
   156 					
   157 					ldy	#0
   158 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   159 					
   160 					NUtils.andba	value, #$0f
   161 					tax
   162 					iny
   163 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   164
   165 					//	Terminating NULL
   166 					iny
   167 					NUtils.movba	#0, "(ptr),y"
   168 					rts
   169 				.endp
