   985 				.endm
   986
   987 				//*************************************************************************************************************************************************
   988
   989 				/// Calculates absolute value of accumulator.
   990 				/**
   991 				*/
   991
   992 				.macro  absa
   993 				    bpl skip
   994 				        eor #$ff
   995 				        clc
   996 				        adc #1
   997 				skip    
   998 				.endm
   999
  1000 				//******************************************************************************************************************************************************
  1001
  1002 				/// Calculates absolute value of accumulator.
  1003 				/**
  1004 				*/
  1004
  1005 				.macro  absac
  1006 				    bcs skip
  1007 				        NUtils.nega
  1008 				skip    
  1009 				.endm
  1010
  1011 				//******************************************************************************************************************************************************
  1012
  1013 				/// Calculates absolute value of a byte.
  1014 				/** @param .byte    Par.
  1015 				*/
  1015
  1016 				.macro  absb
  1017 				    lda %%1
  1018 				    bpl skip
  1019 				        eor #$ff
  1020 				        clc
  1021 				        adc #1
  1022 				        sta %%1
  1023 				skip    
  1024 				.endm
  1025
  1026 				//******************************************************************************************************************************************************
  1027
  1028 				/// Calculates absolute value.
  1029 				/** @param .word    Src or Dst.
  1030 				    @param .word    Dst (optional).
  1031 				*/
  1031
  1032 				.macro  absw
  1033 				    lda %%1+1
  1034 				    bpl skip
  1035 				        
  1036 				        lda #0
  1037 				        sec
  1038 				        sbc %%1
  1039 				        .if %%0 == 1
  1040 				            sta %%1
  1041 				        .else
  1042 				            sta %%2
  1043 				        .endif
  1044 				        
  1045 				        lda #0
  1046 				        sbc %%1+1
  1047 				        .if %%0 == 1
  1048 				            sta %%1+1
  1049 				        .else
  1050 				            sta %%2+1
  1051 				        .endif
  1052 				        
  1053 				        .if %%0 == 2
  1054 				            jmp _exit
  1055 				        .endif
  1056 				skip
  1057 				    .if %%0 == 2
  1058 				        sta %%2+1
  1059 				        lda %%1
  1060 				        sta %%2
  1061 				    _exit:
  1062 				    .endif
  1063 				.endm
  1064
  1065 				//******************************************************************************************************************************************************
  1066
  1067 				/// Negates accumulator.
  1068 				/** @param .byte A  Par.
  1069 				*/
  1069
  1070 				.macro  nega
  1071 				    eor #$ff
  1072 				    clc
  1073 				    adc #1
  1074 				.endm
  1075
  1076 				//******************************************************************************************************************************************************
  1077
  1078 				/// Negates byte.
  1079 				/** @param .byte    Par.
  1080 				*/
  1080
  1081 				.macro  negb
  1082 				    lda #0
  1083 				    sec
  1084 				    sbc %%1
  1085 				    sta %%1
  1086 				.endm
  1087
  1088 				//******************************************************************************************************************************************************
  1089
  1090 				/// Negates word.
  1091 				/** @param .word    Par.
  1092 				*/
  1092
  1093 				.macro  negw
  1094 				    lda #0
  1095 				    sec
  1096 				    sbc %%1
  1097 				    sta %%1
  1098 				    
  1099 				    lda #0
  1100 				    sbc %%1+1
  1101 				    sta %%1+1
  1102 				.endm
  1103
  1104 				//******************************************************************************************************************************************************
  1105
  1106 				/// Negates long.
  1107 				/** @param .long    Par.
  1108 				*/
  1108
  1109 				.macro  negl
  1110 				    lda #0
  1111 				    sec
  1112 				    sbc %%1
  1113 				    sta %%1
  1114 				    
  1115 				    lda #0
  1116 				    sbc %%1+1
  1117 				    sta %%1+1
  1118 				    
  1119 				    lda #0
  1120 				    sbc %%1+2
  1121 				    sta %%1+2
  1122 				.endm
  1123
  1124 				//******************************************************************************************************************************************************
  1125
  1126 				/// Negates dword.
  1127 				/** @param .dword   Par.
  1128 				*/
  1128
  1129 				.macro  negd
  1130 				    lda #0
  1131 				    sec
  1132 				    sbc %%1
  1133 				    sta %%1
  1134 				    
  1135 				    lda #0
  1136 				    sbc %%1+1
  1137 				    sta %%1+1
  1138 				    
  1139 				    lda #0
  1140 				    sbc %%1+2
  1141 				    sta %%1+2
  1142 				    
  1143 				    lda #0
  1144 				    sbc %%1+3
  1145 				    sta %%1+3
  1146 				.endm
  1147
  1148 				//******************************************************************************************************************************************************
  1149
  1150 				/// Sign extension.
