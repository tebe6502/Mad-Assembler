    41 				///	Print text line.
    42 				/**	Procedura wyprowadza na ekran ciag znaków (string) na pozycji X/Y kursora okreslonej przez
    43 					zmienne odpowiednio COLCRS ($55-$56) i ROWCRS ($54). Ciag znaków musi byc zakoñczony zerem.
    44 					Zaklada sie, ze obowiazuja przy tym domyslne ustawienia OS-u, to jest ekran jest
    45 					w trybie Graphics 0, a kanal IOCB 0 jest otwarty dla edytora ekranowego. 
    46 					Maksymalna dopuszczalna dlugosc ciagu to 255 znaków lacznie ze znakiem konca $00.
    47 				*/
    47
    48 4255			.proc	println(.word ptr) .var
    49 = 008A				ptr = NConsole.ptr
    50
    51 					print	ptr
    51 				 MWA ptr NConsole.print.ptr\ JSR NConsole.print
    51 4255 A5 8A 85 8A A5 8B +  MWA ptr NConsole.print.ptr
    51 425D 20 42 42		 JSR NConsole.print
    52 4260 A9 9B			lda	#ATASCII_EOL
    53 4262 4C 65 42			jmp	putc
    54 				.endp
