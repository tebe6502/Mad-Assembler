  1442 				//******************************************************************************************************************************************************
  1443
  1444 				/// Calculates maximum of signed words %%1 and %%2 and stores it in %%3.
  1445 				/** @param .sword %%1   Arg0.
  1446 				    @param .sword %%2   Arg1.
  1447 				    @return .sword %%3
  1448 				*/
  1448
  1449 				.macro  max_sword
  1450 				    lda %%1
  1451 				    cmp %%2
  1452 				    
  1453 				    lda %%1+1
  1454 				    sbc %%2+1
  1455 				    
  1456 				    bmi skip
  1457 				        .if (%%1 != %%3) || (%%1+1 != %%3+1)
  1458 				            NUtils.movw %%1, %%3
  1459 				        .endif
  1460 				        jmp     finish
  1461 				skip
  1462 				    .if (%%2 != %%3) || (%%2+1 != %%3+1)
  1463 				        NUtils.movw %%2, %%3
  1464 				    .endif
  1465 				finish
  1466 				.endm
  1467
  1468 				//******************************************************************************************************************************************************
  1469
  1470 				/// Calculates minimum of signed words %%1 and %%2 and stores it in %%3.
  1471 				/** @param .sword %%1   Arg0.
  1472 				    @param .sword %%2   Arg1.
  1473 				    @return .sword %%3
  1474 				*/
  1474
  1475 				.macro  min_sword
  1476 				    lda %%1
  1477 				    cmp %%2
  1478 				    
  1479 				    lda %%1+1
  1480 				    sbc %%2+1
  1481 				    
  1482 				    bpl skip
  1483 				        .if (%%1 != %%3) || (%%1+1 != %%3+1)
  1484 				            NUtils.movw %%1, %%3
  1485 				        .endif
  1486 				        jmp     finish
  1487 				skip
  1488 				    .if (%%2 != %%3) || (%%2+1 != %%3+1)
  1489 				        NUtils.movw %%2, %%3
  1490 				    .endif
  1491 				finish
  1492 				.endm
  1493
  1494 				//******************************************************************************************************************************************************
  1495
  1496 				/// Calculates maximum of longs %%1 and %%2 and stores it in %%3.
  1497 				/** @param .slong %%1   Arg0.
  1498 				    @param .slong %%2   Arg1.
  1499 				    @return .slong %%3
  1500 				*/
  1500
  1501 				.macro  max_slong
  1502 				    lda %%1
  1503 				    cmp %%2
  1504 				    
  1505 				    lda %%1+1
  1506 				    sbc %%2+1
  1507 				    
  1508 				    lda %%1+2
  1509 				    sbc %%2+2
  1510 				    
  1511 				    bmi skip
  1512 				        .if (%%1 != %%3) || (%%1+1 != %%3+1) || (%%1+2 != %%3+2)
  1513 				            NUtils.movl %%1, %%3
  1514 				        .endif
