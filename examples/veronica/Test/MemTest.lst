   891
   892 				//*************************************************************************************************************************************************
   893
   894 				/// And %%1 with %%2 and store in %%3.
   895 				/** @param %%1  Source.
   896 				    @param %%2  Mask.
   897 				    @param %%3  Destination.
   898 				*/
   898
   899 				.macro  andba
   900 				    lda %%1
   901 				    and %%2
   902 				    .if %%0 > 2
   903 				        sta %%3
   904 				    .endif
   905 				.endm
   906
   907 				//******************************************************************************************************************************************************
   908
   909 				/// Or %%1 with %%2 and store in %%3.
   910 				/** @param %%1  Source.
   911 				    @param %%2  Mask.
   912 				    @param %%3  Destination.
   913 				*/
   913
   914 				.macro  orba
   915 				    lda %%1
   916 				    ora %%2
   917 				    .if %%0 > 2
   918 				        sta %%3
   919 				    .endif
   920 				.endm
   921
   922 				//******************************************************************************************************************************************************
   923
   924 				/// Eor %%1 with %%2 and store in %%3.
   925 				/** @param %%1  Source.
   926 				    @param %%2  Mask.
   927 				    @param %%3  Destination.
   928 				*/
   928
   929 				.macro  eorba
   930 				    lda %%1
   931 				    eor %%2
   932 				    .if %%0 > 2
   933 				        sta %%3
   934 				    .endif
   935 				.endm
   936
   937 				//*************************************************************************************************************************************************
   938
   939 				/// Swap bytes %%1 with %%2 bytes.
   940 				/** @param %%1  Par1.
   941 				    @param %%2  Par2.
   942 				*/
   942
   943 				.macro  swpb
   944 				    ldx %%1
   945 				    ldy %%2
   946 				    stx %%2
   947 				    sty %%1
   948 				.endm
   949
   950 				//*************************************************************************************************************************************************
   951
   952 				/// Assign bits to memory location.
   953 				/** @param %%1  Memory location.
   954 				    @param %%2  Bit mask.
   955 				    @param %%3  Assignment argument.
   956 				*/
   956
   957 				.macro  assign_bits
   958 				    lda %%1
   959 				    and %%2
   960 				    ora %%3
   961 				    sta %%1
   962 				.endm
   963
   964 				//*************************************************************************************************************************************************
   965
   966 				/// Swap words %%1 with %%2.
   967 				/** @param %%1  Par1.
   968 				    @param %%2  Par2.
   969 				*/
   969
   970 				.macro  swpw
   971 				    NUtils.swpb %%1+0, %%2+0
   972 				    NUtils.swpb %%1+1, %%2+1
   973 				.endm
   974
   975 				//*************************************************************************************************************************************************
   976
   977 				/// Swap longs %%1 with %%2.
   978 				/** @param %%1  Par1.
   979 				    @param %%2  Par2.
   980 				*/
   980
   981 				.macro  swpl
   982 				    NUtils.swpb %%1+0, %%2+0
