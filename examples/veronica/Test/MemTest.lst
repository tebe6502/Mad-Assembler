   119 				//******************************************************************************************************************************************************
   120
   121 				///	GETLINE.
   122 				/**	Program czeka, az uzytkownik wpisze ciag znaków z klawiatury i nacisnie klawisz RETURN.
   123 					Znaki podczas wpisywania sa wyswietlane na ekranie, dzialaja tez normalne znaki kontrolne
   124 					(odczyt jest robiony z edytora ekranowego). 
   125
   126 					Wywolanie funkcji polega na zaladowaniu adresu, pod jaki maja byc wpisane znaki,
   127 					do rejestrów A/Y (mlodszy/starszy) i wykonaniu rozkazu JSR GETLINE. Konczacy znak to $9b.
   128 				*/
   128
   129 4272			.proc	get_line(.word ya) .reg
   130 4272				.using NIO
   131 					
   132 					ldx	#$00
   133 					sta	ICBUFA+0,x
   134 					tya
   135 					sta	ICBUFA+1,x
   136
   137 					NUtils.movba	#MAX_STR_LEN, "ICBUFL,x"
   138 					NUtils.movba	#$05, "ICCMD,x"
   139 					
   140 					jmp	CIOV
   141 				.endp
   142
   143 				//******************************************************************************************************************************************************
   144
   145 				///	Convert byte into lowercase, hexadecimal ATASCII string.
   146 				/**	@param .byte value	Value to convert.
   147 					@param .word dst_ptr	Pointer to destination buffer.
   148 				*/
   148
   149 4272			.proc	bta(.byte value .word ptr) .var
   150 					value	= NConsole.value
   151 					ptr 	= NConsole.ptr
   152
   153 					lda	value
   154 					NUtils.lsra	4
   155 					tax
   156 					
   157 					ldy	#0
   158 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   159 					
   160 					NUtils.andba	value, #$0f
   161 					tax
   162 					iny
   163 					NUtils.movba	"hex_to_str_tbl,x", "(ptr),y"
   164
   165 					//	Terminating NULL
   166 					iny
   167 					NUtils.movba	#0, "(ptr),y"
   168 					rts
   169 				.endp
   170
