    88 					jsr	find_first_free_iocb_channel
    89 					bmi	_error
    90
    91 					NUtils.leaw	kbd_dev_str, "ICBUFA,x"
    92 					NUtils.movba	#$04, "ICAX1,x"
    93 					NUtils.movba	#$00, "ICAX2,x"
    94 					lda #$03
    95 					jsr cio_exe
    96 					bmi	_error	// w dobrze zdebugowanym programie raczej nie wyst¹pi tu b³¹d
    97
