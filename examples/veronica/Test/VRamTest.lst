   315 249B			.proc	swap_and_reset
   316 249B				.using	NVeronica.NProtocol, NVeronica.NProtocol.EAtariRegisterStates
   317 					
   318 					//	Reset pulse low, switch rambanks
   319 249B				NVeronica.NProtocol.set_or_switch_bits	Atari_HW_Register, VER_CPU_RESET_MASK, VER_CPU_RESET_PULSE_LOW, RAMBANK_CFG_MASK
Macro: NVeronica.NProtocol.set_or_switch_bits [Source: protocol.h8]
     1 249B AD C0 D5			lda	Atari_HW_Register
     2 249E 29 FE			and	#~(VER_CPU_RESET_MASK)
     7 24A0 49 02				eor	#(RAMBANK_CFG_MASK)
     9 24A2 8D C0 D5			sta	Atari_HW_Register
Source: Master.as8
   320 					
   321 					//	Wait some time.
   322 					//NVeronica.NProtocol.reset_wait
   323
   324 					//	Pulse high. Veronica's CPU should reset now.
   325 24A5				NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, SEMAPHORE_MASK|VER_CPU_RESET_MASK, #(UNLOCK_ATARI|VER_CPU_RESET_PULSE_HIGH)
Macro: NVeronica.NProtocol.set_mem_bits [Source: protocol.h8]
     1 24A5 AD C0 D5			lda	Atari_HW_Register
     2 24A8 29 7E			and	#~(SEMAPHORE_MASK|VER_CPU_RESET_MASK)
     3 24AA 09 81			ora	#(UNLOCK_ATARI|VER_CPU_RESET_PULSE_HIGH)
     4 24AC 8D C0 D5			sta	Atari_HW_Register
Source: Master.as8
   326 					
   327 					//NVeronica.NProtocol.reset_wait
   328 24AF 60				rts
   329 				.endp
