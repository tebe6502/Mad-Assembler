   101 					lda #$07
   102 					jsr cio_exe
   103 					bmi _error	// np. naciœniêto Break
   104
   105 					pha
   106 					lda #$0c
   107 					jsr cio_exe
   108 					pla
   109 					rts
   110
   111 23FB			_error
   112 					rts
   113
   114 23FB			cio_exe
   115 					sta ICCMD,x
   116 					jmp CIOV
   117 				.endp
