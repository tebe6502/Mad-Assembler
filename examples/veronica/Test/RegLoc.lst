    41 				//******************************************************************************************************************************************************
    42
    43 				///	Boot Veronica.
    44 				/**	@param .word_ptr boot_src_ptr	- Bootstrap source location.
    45 					@param .word_ptr boot_dst_ptr	- Bootstrap destination location (window).
    46 					@param .word_ptr boot_size		- Bootstrap size.
    47 					@param .word_ptr bios_src_ptr		- Bios source location.
    48 					@param .word_ptr bios_dst_ptr		- Bios destination location (window).
    49 					@param .word_ptr bios_size			- Bios size.	
    50 				*/
    50
    51 2364			.proc	boot_veronica(.word boot_src_ptr .word boot_dst_ptr .word boot_size .word bios_src_ptr .word bios_dst_ptr .word bios_size .word startup_ptr) .var
    52 2364				.var	.word boot_src_ptr, boot_dst_ptr, boot_size, bios_src_ptr, bios_dst_ptr, bios_size//, startup_ptr
    53 = BFFC				startup_ptr = NVeronica.NProtocol.Atari_Window_Location+(NCpu.CPURES-NVeronica.NProtocol.Initial_Window_Location)
    54 					
    55 					//	Copy bootstrap
    56 					NMemory.memcpy	boot_dst_ptr, boot_src_ptr, boot_size
    56 				 MWA boot_dst_ptr NMemory.memcpy.dst_ptr\ MWA boot_src_ptr NMemory.memcpy.src_ptr\ MWA boot_size NMemory.memcpy.count\ JSR NMemory.memcpy
    56 2364 AD B0 23 85 80 AD +  MWA boot_dst_ptr NMemory.memcpy.dst_ptr
    56 236E AD AE 23 85 82 AD +  MWA boot_src_ptr NMemory.memcpy.src_ptr
    56 2378 AD B2 23 8D E5 22 +  MWA boot_size NMemory.memcpy.count
    56 2384 20 5C 22		 JSR NMemory.memcpy
    57 					
    58 					//	Copy BIOS
    59 					NMemory.memcpy	bios_dst_ptr, bios_src_ptr, bios_size
    59 				 MWA bios_dst_ptr NMemory.memcpy.dst_ptr\ MWA bios_src_ptr NMemory.memcpy.src_ptr\ MWA bios_size NMemory.memcpy.count\ JSR NMemory.memcpy
    59 2387 AD B6 23 85 80 AD +  MWA bios_dst_ptr NMemory.memcpy.dst_ptr
    59 2391 AD B4 23 85 82 AD +  MWA bios_src_ptr NMemory.memcpy.src_ptr
    59 239B AD B8 23 8D E5 22 +  MWA bios_size NMemory.memcpy.count
    59 23A7 20 5C 22		 JSR NMemory.memcpy
    60
    61 					/*swap_banks
    62 					reset_veronica*/
    62
    63 23AA 20 C9 23			swap_and_reset
    64 23AD 60				rts
    65 = 23AE 00 00		boot_src_ptr
    65 = 23B0 00 00		boot_dst_ptr
    65 = 23B2 00 00		boot_size
    65 = 23B4 00 00		bios_src_ptr
    65 = 23B6 00 00		bios_dst_ptr
    65 = 23B8 00 00		bios_size
    65 				.endp
    66
    67 				//******************************************************************************************************************************************************
    68
    69 				///	Identify Veronica's presence.
    70 				/**	@param .byte timeout	- Timeout.
    71 					@return	.byte A	- Status flag indicating Veronica's presence.
    72 				*/
    72
    73 23BA			.proc	identify(.byte timeout) .var
    74 23BA				.var .byte	timeout
    75
    76 					//	Clear rambank memory to make sure Veronica overwrites it.
    77 					NUtils.movba	#NVeronica.NProtocol.ECommand.IDLE, NVeronica.NProtocol.Atari_Window_Ramlo
    78 					
    79 					setup_identify_cmd
    80 					execute_command_with_timeout	timeout
    81 					cmp	#NUtils.TRUE
    82 					beq	cont
    83 						//	Timeout. Veronica absent or timed out.
    84 						//lda	#NUtils.FALSE
    85 						rts
    86 					
    87 				//------------------------------------------------------------------------------------------------------------------------------------------------------
    88
    89 23BA			cont
    90 					//	Wait for Veronica until she finishes executing the IDENTIFY command or timeouts.
    91 					wait_for_veronica_with_timeout	#NVeronica.NProtocol.IDENTIFY_CMD_TIMEOUT
    92 					cmp	#NUtils.TRUE
    93 					beq	cont_2
    94 						//	Veronica absent or timed out.
    95 						//lda	#NUtils.FALSE
    96 						rts
    97
    98 				//------------------------------------------------------------------------------------------------------------------------------------------------------
    99
   100 23BA			cont_2
   101 					swap_banks
   102 					NMemory.strcmphp	#(NVeronica.NProtocol.Atari_Window_Ramlo+NVeronica.NProtocol.SIdentifyCmd.m_uuid), #uuid_template_tbl, #NVeronica.NProtocol.VERONICA_UUID_SIZE
   103 					//	NMemory.strcmphp returns the appropriate exit status.
   104 					rts
   105 				.endp
   106
