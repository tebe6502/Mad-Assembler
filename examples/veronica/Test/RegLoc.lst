   121 				/**	@param .byte X	- Timeout
   122 					@return .byte A	- Status.
   123 				*/
   123
   124 23BA			.proc	execute_command_with_timeout(.byte x) .reg
   125 					jsr	wait_for_veronica_with_timeout
   126 					cmp	#NUtils.TRUE
   127 					beq	cont
   128 						//lda	#NUtils.FALSE
   129 						rts
   130 23BA			cont
   131 					unlock_and_swap
   132 					lda	#NUtils.TRUE
   133 					rts
   134 				.endp
