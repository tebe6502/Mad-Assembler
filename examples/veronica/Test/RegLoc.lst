    66 				//	Gets TV system.
    67 				/**	@return .bool A	TV System.
    68 						0	PAL/SECAM.
    69 						1	NTSC.
    70 				*/
    70
    71 234D			.proc	get_tv_system
    72 					lda	NGtia.PAL
    73 					and	#%00000010
    74 					lsr	@
    75 					rts
    76 				.endp
    77
    78 				//******************************************************************************************************************************************************
    79
    80 				//	Gets TV system fps.
    81 				/**	@return .byte A	Fps.
    82 						#50 for PAL/SECAM
    83 						#60 for NTSC
    84 				*/
    84
    85 234D			.proc	get_tv_fps
    86 					jsr	get_tv_system
    87 					asl	@
    88 					tay
    89 					lda	fps,y
    90 					rts
    91 					
    92 234D				fps: dta b(50), b(60)
    93 				.endp
    94
    95 				//******************************************************************************************************************************************************
    96
    97 				//	Gets number of tv lines.
    98 				/**	@return .byte A Number of lines.
    99 						#156 for PAL/SECAM
   100 						#131 for NTSC
   101 				*/
   101
   102 234D			.proc	get_num_vcount_lines
   103 					jsr	get_tv_system
   104 					asl	@
   105 					tay
   106 					lda	fps,y
   107 					rts
   108 					
   109 234D				fps: dta b(156), b(131)
   110 				.endp
   111
