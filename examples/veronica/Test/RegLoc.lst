   338 				///	Copy data chunk from source into destination location. Range restricted to one page only. Uses code auto-modification.
   339 				/**	@param .word dst_ptr	Destination location pointer. Should be page aligned to achieve best performance.
   340 					@param .word src_ptr	Source location pointer. Should be page aligned to achieve best performance.
   341 					@param .byte count		Count (1-255).
   342 				*/
   342
   343 22E5			.proc	memcpyp(.word dst_ptr .word src_ptr .byte count) .var
   344 					count	= NMemory.count
   345
   346 					ldy	#0	
   347 22E5			loop
   348 					src_ptr = * + 1
   349 						lda $ffff,y	// auto-modification
   350 					dst_ptr = * + 1
   351 						sta $ffff,y	// auto-modification
   352 					
   353 					iny
   354 					cpy	count
   355 					bne	loop
   356 					rts
   357 				.endp
