   297 22E5						.local	loop
   298 								lda	(src_ptr),y
   299 								sta	(dst_ptr),y
   300 								iny
   301 								cpy	count
   302 								bne	loop
   303 							.endl
   304 					
   305 22E5					_exit:	rts
   306 						.endp
   307 				.endp
