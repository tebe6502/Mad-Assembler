    49 2343			.proc	wait_for_vbl(.byte x) .reg
    50 2343			loop
    51 2343 A5 14			lda	RTCLOK+2
    52
    53 2345				.local
    54 2345				loop:
    55 2345 C5 14				cmp	RTCLOK+2
    56 2347 F0 FC				beq	loop
    57 					.endl
    58
    59 2349 CA				dex
    60 234A D0 F7			bne	loop
    61 234C 60				rts
