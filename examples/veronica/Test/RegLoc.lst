   244
   245 				//******************************************************************************************************************************************************
   246
   247 				///	Copy data chunk from source into destination location.
   248 				/**	@param .word dst_ptr	Destination location pointer.
   249 					@param .word src_ptr	Source location pointer.
   250 					@param .word count		Count.
   251 				*/
   251
