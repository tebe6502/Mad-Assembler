    28 				///	Enable rambanks.
    29 				/**	@param .byte rambank_bits	- Rambank bit combination.
    30 				*/
    30
    31 234D			.proc	set_rambanks(.byte rambank_bits) .var
    32 234D				.var .byte	rambank_bits
    33 					
    34 234D				.using	NVeronica.NProtocol.EAtariRegisterStates
    35 					
    36 				    // TODO: Should not set b7 in $d500!!! Leave it unchanged.
    37 234D				NVeronica.NProtocol.set_or_switch_mem_bits	NVeronica.NProtocol.Atari_HW_Register, BANKS_MASK, SEMAPHORE_MASK, rambank_bits
Macro: NVeronica.NProtocol.set_or_switch_mem_bits [Source: protocol.h8]
     1 234D AD 63 23			lda	rambank_bits
     2 2350 29 30			and	#(BANKS_MASK)
     3 2352 8D 63 23			sta	rambank_bits
     5 2355 AD C0 D5			lda	NVeronica.NProtocol.Atari_HW_Register
     6 2358 29 CF			and	#~(BANKS_MASK)
     8 235A 49 80				eor	#(SEMAPHORE_MASK)
    10 235C 0D 63 23			ora	rambank_bits
    11 235F 8D C0 D5			sta	NVeronica.NProtocol.Atari_HW_Register
Source: Master.as8
    38 2362 60				rts
    39 = 2363 00		rambank_bits
    39 				.endp
