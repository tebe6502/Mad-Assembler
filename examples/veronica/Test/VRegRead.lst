   261 				//******************************************************************************************************************************************************
   262
   263 				///	Copy data chunk from source into destination location in forward direction.
   264 				/**	@param .word dst_ptr	Destination location pointer.
   265 					@param .word src_ptr	Source location pointer.
   266 					@param .word count		Count.
   267 				*/
   267
   268 2427			.proc	fwdmemcpy(.word dst_ptr .word src_ptr .word count) .var
   269 					dst_ptr = NMemory.ptr
   270 					src_ptr = NMemory.ptr2
   271 					count = NMemory.count
   272
   273 					ldy	#0
   274
   275 					ldx	count+1
   276 					beq	copy_last_page
   277 						
   278 						sty	copy.count
   279 						
   280 2427					.local	copy_pages
   281 							jsr	copy
   282 							inc	src_ptr+1
   283 							inc	dst_ptr+1
   284 							dex
   285 							bne	copy_pages
   286 						.endl
   287
   288 2427			copy_last_page
   289 					lda	count
   290 					beq	copy._exit
   291
   292 						sta	copy.count
   293
   294 2427					.proc	copy(.byte count) .var
   295 2427						.var	.byte	count
   296
   297 2427						.local	loop
   298 								lda	(src_ptr),y
   299 								sta	(dst_ptr),y
   300 								iny
   301 								cpy	count
   302 								bne	loop
   303 							.endl
   304 					
   305 2427					_exit:	rts
   306 						.endp
   307 				.endp
   308
   309 				//******************************************************************************************************************************************************
   310
   311 				///	Copy data chunk from source into destination location. Range restricted to one page only. Uses code auto-modification.
   312 				/**	@param .word dst_ptr	Destination location pointer. Should be page aligned to achieve best performance.
   313 					@param .word src_ptr	Source location pointer. Should be page aligned to achieve best performance.
   314 					@param .byte count		Count.
   315 				*/
   315
   316 2427			.proc	memcpyhp(.word dst_ptr .word src_ptr .byte count) .var
   317 					count	= NMemory.count
   318 					
   319 					ldy	count
   320 					bne	continue
   321 					rts
   322
   323 2427			continue
   324 					dey
   325 2427			loop
   326 					src_ptr = * + 1
   327 						lda $ffff,y	// auto-modification
   328 					dst_ptr = * + 1
   329 						sta	$ffff,y	// auto-modification
   330 					
   331 					dey
   332 					bpl	loop
   333 					rts
   334 				.endp
   335
   336 				//******************************************************************************************************************************************************
   337
   338 				///	Copy data chunk from source into destination location. Range restricted to one page only. Uses code auto-modification.
   339 				/**	@param .word dst_ptr	Destination location pointer. Should be page aligned to achieve best performance.
   340 					@param .word src_ptr	Source location pointer. Should be page aligned to achieve best performance.
   341 					@param .byte count		Count (1-255).
   342 				*/
   342
   343 2427			.proc	memcpyp(.word dst_ptr .word src_ptr .byte count) .var
   344 					count	= NMemory.count
   345
   346 					ldy	#0	
   347 2427			loop
   348 					src_ptr = * + 1
   349 						lda $ffff,y	// auto-modification
   350 					dst_ptr = * + 1
   351 						sta $ffff,y	// auto-modification
   352 					
   353 					iny
   354 					cpy	count
   355 					bne	loop
   356 					rts
   357 				.endp
   358
   359 				//******************************************************************************************************************************************************
   360
   361 				///	Copy data chunk from source into destination location.
   362 				/**	@param .word dst_ptr	Destination location pointer.
   363 					@param .word dst_modulo	Destination modulo.
   364 					@param .word src_ptr	Source location pointer.
   365 					@param .byte width		Width.
   366 					@param .byte height		Height.
   367 					@param .word src_modulo	Source modulo.
   368 				*/
   368
   369 2427			.proc	memcpym(.word dst_ptr .word dst_modulo .word src_ptr .byte width .byte height .word src_modulo) .var
   370 					dst_ptr = NMemory.ptr
   371 2427				.var	.word	dst_modulo
   372 					src_ptr = NMemory.ptr2
   373 2427				.var	.word	src_modulo
   374 					
   375 2427			loop_y
   376 					ldy	#0
   377 2427			loop_x
   378 					NUtils.movba	"(src_ptr),y", "(dst_ptr),y"
   379 					iny
   380 					cpy	width
   381 					bne	loop_x
   382 					
   383 					NUtils.addw	src_ptr, src_modulo, src_ptr
   384 					NUtils.addw	dst_ptr, dst_modulo, dst_ptr
   385
   386 					dec	height
   387 					bne	loop_y
   388 					rts
   389 				.endp
   390
   391 				//******************************************************************************************************************************************************
   392
   393 				///	Backup memory locations.
   394 				/**	@param .word tbl_ptr	Backup table pointer.
   395 				*/
   395
   396 2427			.proc	backup(.word tbl_ptr) .var
   397 					tbl_ptr = NMemory.ptr
   398 					tmp_ptr = NMemory.ptr2
   399 					
   400 2427			loop
   401 					ldy	#0
   402 					NUtils.cmpba	"(tbl_ptr),y", #EType.NONE
   403 					bne	cont
   404 						//	Exit.
   405 						rts
   406 2427			cont
   407 					ldy	#1
   408 					NUtils.movba	"(tbl_ptr),y", tmp_ptr
   409 					iny
   410 					NUtils.movba	"(tbl_ptr),y", tmp_ptr+1
   411
   412 					//	Copy the first byte.
   413 					ldy	#0
   414 					lda	(tmp_ptr),y
   415 					ldy	#3
   416 					sta	(tbl_ptr),y
   417 					
   418 					//	if	(tbl_ptr[0] == EType.BYTE)
   419 					ldy	#0
   420 					NUtils.cmpba	"(tbl_ptr),y", #EType.BYTE
   421 					bne	cont_2
   422 						NUtils.addbw	tbl_ptr, #4, tbl_ptr
   423 						jmp	loop
   424 					
   425 2427			cont_2
   426 					//	if	(tbl_ptr[0] == EType.WORD)
   427 					//ldy	#0
   428 					NUtils.cmpba	"(tbl_ptr),y", #EType.WORD
   429 					bne	cont_3
   430 						//	Copy second byte.
   431 						ldy	#1
   432 						lda	(tmp_ptr),y
   433 						ldy	#4
   434 						sta	(tbl_ptr),y
   435 						NUtils.addbw	tbl_ptr, #5, tbl_ptr
   436 						jmp	loop
   437 					
   438 2427			cont_3
   439 					jmp	loop
   440 				.endp
   441
   442 				//******************************************************************************************************************************************************
