   461 					NUtils.movba	"(tbl_ptr),y", tmp_ptr+1
   462
   463 					//	Copy the first byte.
   464 					ldy	#3
   465 					lda	(tbl_ptr),y
   466 					ldy	#0
   467 					sta	(tmp_ptr),y
   468 					
   469 					//	if	(tbl_ptr[0] == EType.BYTE)
