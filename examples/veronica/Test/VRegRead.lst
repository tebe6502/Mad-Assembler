    78 					size = * + 1
    79 						ldy	#$ff
    80 					dey
    81 239E			loop
    82 					tbl0_ptr = *+1
    83 						lda	$ffff,y
    84 					tbl1_ptr = *+1
    85 						cmp	$ffff,y
    86 					bne	inequality
    87 					
    88 					dey
    89 					bpl	loop
    90 					
    91 					//	equality
    92 					lda	#NUtils.TRUE
    93 					rts
    94
    95 239E			inequality
    96 					lda	#NUtils.FALSE
    97 					rts
    98 				.endp
