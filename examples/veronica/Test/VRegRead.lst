   121 				///	GETLINE.
   122 				/**	Program czeka, az uzytkownik wpisze ciag znaków z klawiatury i nacisnie klawisz RETURN.
   123 					Znaki podczas wpisywania sa wyswietlane na ekranie, dzialaja tez normalne znaki kontrolne
   124 					(odczyt jest robiony z edytora ekranowego). 
   125
   126 					Wywolanie funkcji polega na zaladowaniu adresu, pod jaki maja byc wpisane znaki,
   127 					do rejestrów A/Y (mlodszy/starszy) i wykonaniu rozkazu JSR GETLINE. Konczacy znak to $9b.
   128 				*/
   128
   129 245E			.proc	get_line(.word ya) .reg
   130 245E				.using NIO
   131 					
   132 					ldx	#$00
   133 					sta	ICBUFA+0,x
   134 					tya
   135 					sta	ICBUFA+1,x
   136
   137 					NUtils.movba	#MAX_STR_LEN, "ICBUFL,x"
   138 					NUtils.movba	#$05, "ICCMD,x"
   139 					
   140 					jmp	CIOV
   141 				.endp
