    23 239E			.proc	strcmp(.word tbl0_ptr .word tbl1_ptr .word count) .var
    24 					tbl0_ptr = NMemory.ptr
    25 					tbl1_ptr = NMemory.ptr2
    26 					count = NMemory.count
    27
    28 					ldy	#0
    29 					ldx	count+1
    30 					beq	last_page
    31
    32 239E				.local	full_pages
    33 239E				loop:
    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 239E				.local	last_page
    47 						lda	count
    48 						beq	equal
    49 239E				loop:
    50 						lda	(tbl0_ptr),y
    51 						cmp	(tbl1_ptr),y
    52 						bne	unequal
    53 						iny
    54 						cpy	count
    55 						bne	loop
    56 					.endl	
    57 					
    58 239E			equal
    59 					lda	#NUtils.TRUE
    60 					rts
    61 					
    62 239E			unequal
    63 					lda	#NUtils.FALSE
    64 					rts
    65 				.endp
