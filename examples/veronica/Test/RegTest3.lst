   108
   109 				///	Execute command.
   110 				/**
   111 				*/
   111
   112 22BB			.proc	execute_command
   113 					wait_for_veronica
   114 					unlock_and_swap
   115 					rts
   116 				.endp
   117
   118 				//******************************************************************************************************************************************************
   119
   120 				///	Execute command. Use timeout limitation.
   121 				/**	@param .byte X	- Timeout
   122 					@return .byte A	- Status.
   123 				*/
   123
   124 22BB			.proc	execute_command_with_timeout(.byte x) .reg
   125 					jsr	wait_for_veronica_with_timeout
   126 					cmp	#NUtils.TRUE
   127 					beq	cont
   128 						//lda	#NUtils.FALSE
   129 						rts
   130 22BB			cont
   131 					unlock_and_swap
   132 					lda	#NUtils.TRUE
   133 					rts
   134 				.endp
