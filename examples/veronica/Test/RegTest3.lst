   296 22CA			.proc	reset_veronica
   297 22CA				.using	NVeronica.NProtocol, NVeronica.NProtocol.EAtariRegisterStates
   298 					
   299 					//	Pulse low
   300 22CA				NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, VER_CPU_RESET_MASK|SEMAPHORE_MASK, #(VER_CPU_RESET_PULSE_LOW | LOCK_ATARI)
Macro: NVeronica.NProtocol.set_mem_bits [Source: protocol.h8]
     1 22CA AD C0 D5			lda	Atari_HW_Register
     2 22CD 29 7E			and	#~(VER_CPU_RESET_MASK|SEMAPHORE_MASK)
     3 22CF 09 00			ora	#(VER_CPU_RESET_PULSE_LOW | LOCK_ATARI)
     4 22D1 8D C0 D5			sta	Atari_HW_Register
Source: Master.as8
   301 					
   302 					//	Wait some time.
   303 22D4				NVeronica.NProtocol.reset_wait
Macro: NVeronica.NProtocol.reset_wait [Source: protocol.h8]
     1 22D4 A2 00			ldx	#0
     2 22D6			loop
     4 22D6 EA					nop
     4 22D7 EA					nop
     4 22D8 EA					nop
     4 22D9 EA					nop
     4 22DA EA					nop
     4 22DB EA					nop
     4 22DC EA					nop
     4 22DD EA					nop
     4 22DE EA					nop
     4 22DF EA					nop
     4 22E0 EA					nop
     4 22E1 EA					nop
     4 22E2 EA					nop
     4 22E3 EA					nop
     4 22E4 EA					nop
     4 22E5 EA					nop
     4 22E6 EA					nop
     4 22E7 EA					nop
     7 22E8 CA				dex
     8 22E9 D0 EB			bne	loop
Source: Master.as8
   304
   305 					//	Pulse high. Veronica's CPU should reset now.
   306 22EB				NVeronica.NProtocol.set_mem_bits	Atari_HW_Register, VER_CPU_RESET_MASK|SEMAPHORE_MASK, #(VER_CPU_RESET_PULSE_HIGH | UNLOCK_ATARI)
Macro: NVeronica.NProtocol.set_mem_bits [Source: protocol.h8]
     1 22EB AD C0 D5			lda	Atari_HW_Register
     2 22EE 29 7E			and	#~(VER_CPU_RESET_MASK|SEMAPHORE_MASK)
     3 22F0 09 81			ora	#(VER_CPU_RESET_PULSE_HIGH | UNLOCK_ATARI)
     4 22F2 8D C0 D5			sta	Atari_HW_Register
Source: Master.as8
   307 					
   308 					//NVeronica.NProtocol.reset_wait
   309 					//	Allow Veronica's CPU to stabilize.
   310 22F5 60				rts
   311 				.endp
