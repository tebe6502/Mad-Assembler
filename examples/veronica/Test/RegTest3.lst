Macro: NVeronica.NProtocol.set_or_switch_mem_bits [Source: protocol.h8]
     1 22A4 AD BA 22			lda	rambank_bits
     2 22A7 29 30			and	#(BANKS_MASK)
     3 22A9 8D BA 22			sta	rambank_bits
     5 22AC AD C0 D5			lda	NVeronica.NProtocol.Atari_HW_Register
