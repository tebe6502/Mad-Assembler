   100 				//******************************************************************************************************************************************************
   101
   102 				///	Set memory. Uses code auto-modification.
   103 				/**	@param .word %%1	Destination location.
   104 					@param .word %%2	Count.
   105 					@param .byte %%3	Value.
   106 				*/
   106
   107 21C0			.proc	memset(.word dst_ptr .word count .byte value) .var
   108 					dst_ptr	= NMemory.ptr
   109 					count	= NMemory.count
   110 					value	= NMemory.value
   111 					
   112 					ldx	value
   113 					ldy	#0
   114 21C0			loop
   115 					//	Test, whether we are done or not.
   116 					NUtils.tstzw	count
   117 					beq	done
   118 						txa
   119 						sta	(dst_ptr),y
   120 					
   121 					NUtils.decw	count
   122 					iny
   123 					bne	loop
   124 					
   125 					inc	dst_ptr+1
   126 					jmp	loop
   127 21C0			done
   128 					rts
   129 				.endp
   130
   131 				//******************************************************************************************************************************************************
   132
   133 				///	Set memory. Range restricted to one page only. Uses code auto-modification.
   134 				/**	@param .word dst_ptr	Destination pointer. Should be page aligned to achieve best performance.
   135 					@param .byte count	Count.
   136 					@param .byte value	Value.
   137 				*/
   137
   138 21C0			.proc	memsetp(.word dst_ptr .byte count .byte value) .var
   139 					value = * + 1
   140 						lda	#0
   141 					count = * + 1	// auto-modification
   142 						ldy	#0
