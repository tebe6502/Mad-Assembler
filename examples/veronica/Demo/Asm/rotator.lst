     1 6425				loop:
     2 6425 AD C0 D5				lda	Atari_HW_Register
     3 6428 29 80				and	#(1 << (EAtariRegisterBits.SEMAPHORE_READ))
     5 642A D0 0D					bne	matched
     2 642C A0 00			ldy	#0
     3 642E			loop
     4 642E C8				iny
     5 642F D0 FD			bne	loop
