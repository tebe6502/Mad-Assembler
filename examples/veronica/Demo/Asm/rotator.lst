   181 					_fptoa	#fp, dst_ptr
   182 					NAlgorithm.find_first_of	dst_ptr, #$9b
   183 					NUtils.movba	#0, "(dst_ptr),y"
   184 					rts
   185
   186 					fp:	.ds 6	//	FP0 number buffer
   187 				.endp*/
