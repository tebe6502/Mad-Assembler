    34 						lda	(tbl0_ptr),y
    35 						cmp	(tbl1_ptr),y
    36 						bne	unequal
    37 						iny
    38 						bne	loop
    39 					
    40 						inc	tbl0_ptr+1
    41 						inc	tbl1_ptr+1
    42 						dex
    43 						bne	loop
    44 					.endl
    45
    46 601C				.local	last_page
