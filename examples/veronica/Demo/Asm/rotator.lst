   331 6293			.proc	div_u32_by_u16
   332 					NUtils.lead	0, math_arg2
   333 					ldy	#$20
   334 6293			loop
   335 					NUtils.lsld	math_arg0, 1
   336 					NUtils.rold	math_arg2, 1
   337 					NUtils.subwd	math_arg2, math_arg1, math_arg3
   338 					bcc	skip
   339 					NUtils.movd	math_arg3, math_arg2
   340 					inc	math_arg0+0
   341 6293			skip
   342 					dey
   343 					bne	loop
   344 					rts
   345 				.endp
   346
   347 				//******************************************************************************************************************************************************
   348
   349 				/// Fractional part.
   350 				/**	@param .word math_arg0	Unsigned divident (16-bits).
   351 					@param .word math_arg1	Unsigned divisor (16-bits).
   352 					@return .word math_arg2	Unsigned result (16-bits).
   353 					assert(Divident < Divisior)
   354 				*/
   354
   355 6293			.proc	fract_u16_r16
   356 					.macro	fract_u16_r16_macro
   357 						txa	// 2
   358 						asl	@ // 2
   359 						rol math_arg0+1 // 5
   360 						bcs	skip1 // 3, 2
   361 				
   362 						sta	math_arg0 // 3
   363 						sbc	math_arg1+2 // 3
   364 						tax // 2
   365 						lda	math_arg0+1 // 3
   366 						sbc	math_arg1+3 // 3
   367 						bcs	skip2 // 3,2
   368 						ldx	math_arg0 // 3
   369 						bcc	skip3 // 3
   370 				
   371 					skip1:
   372 						sbc	math_arg1 // 3
   373 						tax // 2
   374 						lda	math_arg0+1 // 3
   375 						sbc	math_arg1+1 // 3
   376 					skip2:
   377 						sta	math_arg0+1 // 3
   378 						tya // 2
   379 						ora	%%1 //2
   380 						tay // 2
   381 					skip3:
   382 					.endm
   383
   384 					NUtils.movw	math_arg1, math_arg1+2
   385 					NUtils.decw		math_arg1+2
   386 					
   387 					ldx	math_arg0
   388 					ldy	#0
   389 					fract_u16_r16_macro	#$80
   390 					fract_u16_r16_macro	#$40
   391 					fract_u16_r16_macro	#$20
   392 					fract_u16_r16_macro	#$10
   393 					fract_u16_r16_macro	#$08
   394 					fract_u16_r16_macro	#$04
   395 					fract_u16_r16_macro	#$02
   396 					fract_u16_r16_macro	#$01
   397 					sty	math_arg2+1
   398
   399 					ldy	#0
   400 					fract_u16_r16_macro #$80
   401 					fract_u16_r16_macro	#$40
   402 					fract_u16_r16_macro	#$20
   403 					fract_u16_r16_macro	#$10
   404 					fract_u16_r16_macro	#$08
   405 					fract_u16_r16_macro	#$04
   406 					fract_u16_r16_macro	#$02
   407 					fract_u16_r16_macro	#$01
   408 					sty	math_arg2
   409 					
   410 					rts
   411 				.endp
   412
