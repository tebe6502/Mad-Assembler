    12
    13 				///	Open IOCB channel.
    14 				/**	@param .byte channel	Channel*16.
    15 					@param .byte command	Command.
    16 					@param .word filename_ptr	Filename pointer.
    17 				*/
    17
    18 62A0			.proc	open(.byte channel .byte command .word filename_ptr) .var
    19 					channel	= NIO.channel
    20 					command = NIO.command
    21 62A0				.var	.word	filename_ptr
    22 					
    23 					ldx	channel
    24 					NUtils.movba	#3, "IOCB+2,x"	// CIO command $03 - OPEN
    25 					NUtils.movba	filename_ptr+0, "IOCB+4,x"	// file name
    26 					NUtils.movba	filename_ptr+1, "IOCB+5,x"	// file name
    27 					NUtils.movba	command, "IOCB+$a,x"	// $04 - READ ; $08 - WRITE
    28 					jmp	NIO.CIOV
    29 				.endp
    30
    31 				//******************************************************************************************************************************************************
    32
    33 				///	Close IOCB channel.
    34 				/**	@param .byte X	Channel*16.
    35 				*/
    35
    36 62A0			.proc	close(.byte x) .reg
    37 					NUtils.movba	#$0c, "IOCB+2,x"	// CIO command
    38 					jmp	NIO.CIOV
    39 				.endp
    40
    41 				//******************************************************************************************************************************************************
    42
    43 				///	Execute IOCB channel command.
    44 				/**	Command:
    45 					$05 - GET RECORD
    46 					$07 - GET CHARACTER
    47 					$09 - PUT RECORD
    48 					$0B - PUT CHARACTERS
    49 					Example:
    50 						read channel , #command , #buffer , #length
    51 						read #$10 , command , buffer , length
    52 						channel = $10,$20,$30 ...
    53 				*/
    53
    54 62A0			.proc	execute_command(.byte channel .byte command .word buffer_ptr .word length) .var
    55 					channel	= NIO.channel
    56 					command = NIO.command
    57 62A0				.var	.word	buffer_ptr, length
    58
    59 					ldx	channel
    60 					NUtils.movba	command, "IOCB+2,x"	// CIO command
    61 					NUtils.movba	buffer_ptr+0, "IOCB+4,x"	// buffer address
    62 					NUtils.movba	buffer_ptr+1, "IOCB+5,x"	// buffer address
    63 					NUtils.movba	length+0, "IOCB+8,x"
    64 					NUtils.movba	length+1, "IOCB+9,x"
    65 					jmp	NIO.CIOV
    66 				.endp
    67
    68 				//******************************************************************************************************************************************************
    69
    70 				///	Search for the first free IOCB channel.
    71 				/**	@return .byte X	- Channel*16.
    72 					@return .byte Y	- Exit code.
    73 				*/
    73
    74 62A0			.proc	find_first_free_iocb_channel
    75 62A0 A2 00			ldx #$00
    76 62A2 A0 01			ldy #$01
    77 					
    78 62A4			loop
    79 62A4				NUtils.cmpba	"ICCHID,x", #$ff
Macro: NUtils.cmpba [Source: utils.as8]
     1 62A4 BD 40 03		    lda ICCHID,x
     2 62A7 C9 FF		    cmp #$ff
Source: io.as8
    80 62A9 F0 09			beq found
    81 					
    82 62AB 8A				txa
    83 62AC 18				clc
    84 62AD 69 10			adc #$10
    85 62AF AA				tax
    86 62B0 10 F2			bpl loop
    87 					
    88 62B2 A0 A1			ldy #IO_ERROR_CODE_TOO_MANY_CHANNELS_OPEN
    89 62B4			found
    90 62B4 60				rts
    91 				.endp
    92
    93 				//******************************************************************************************************************************************************
    94
    95 = 62B5 00		channel
    95 = 62B6 00		command
    95 				.endl // NIO
